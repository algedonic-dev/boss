[Unit]
Description=Boss — conservation-invariant sweep
Documentation=https://github.com/algedonic-dev/boss/blob/main/docs/design/correctness-protocol.md
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=boss
Environment=PGPASSWORD=boss
# Packet pinned to the system of record, best-effort: a bundle-only kind
# that the local drop-in target has never heard of (400 every hour
# until 2026-09-08; see boss-ml-inference-batch.service, e109f57e).
ExecStartPre=-/usr/bin/env BOSS_JOBS_URL=http://10.20.0.34:7900 /opt/boss/infra/boss-maintenance-wrap.sh maintenance-conservation-invariants "Conservation-invariant sweep"
ExecStart=/opt/boss/infra/lint/conservation-invariants.sh
ExecStopPost=-/usr/bin/env BOSS_JOBS_URL=http://10.20.0.34:7900 /opt/boss/infra/boss-step.sh maintenance-conservation-invariants run
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

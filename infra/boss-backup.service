[Unit]
Description=Boss backup (pg_dump + configs)
After=postgresql.service

[Service]
Type=oneshot
# Maintenance visibility (internal-forge Q6): the run is a Job.
# Pre ensures the open Job (spawns today's, or reuses a standing
# failure so recovery closes it); Post completes `run` on SUCCESS
# only — a failed run leaves the Job open and loud.
ExecStartPre=/opt/boss/infra/boss-maintenance-wrap.sh maintenance-backup "Nightly backup"
ExecStart=/opt/boss/infra/backup.sh
ExecStopPost=-/opt/boss/infra/boss-step.sh maintenance-backup run
User=root

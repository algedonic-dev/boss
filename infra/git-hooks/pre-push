#!/usr/bin/env bash
# Run the pre-flight before a push leaves this machine.
#
# WHY A HOOK AND NOT A HABIT. `infra/gate.sh --lint` takes about nine
# and a half minutes on a warm worktree target, and about seven and a
# half when the tree changes no crate (measured on the dev pod
# 2026-10-18, backlog 1c03eeb0: 561 s in all — 47 s of fmt and the
# build-free lints, 123 s of workspace clippy, 387 s of the 64 tree-wide
# pins, run one crate at a time). It was ~22 seconds until the pins
# joined it (backlog 2f0c722a); this line said so for two days after,
# and a promise of seconds that takes minutes invites Ctrl-C or a
# reflexive BOSS_SKIP_PREFLIGHT=1. It still pays: it catches the class
# of failure that otherwise costs a full gate:
# roughly 40 minutes of cluster time, a scheduled pod and a clone, to
# learn that `cargo fmt` was run on one crate and not another. That
# happened on 2026-08-28 (gate-p54fw, fails:[fmt]).
#
# It happened AGAIN the same day, after --quick existed, because the
# pre-flight was invoked with `;` instead of `&&` and the commit ran
# anyway. A step that has to be remembered, and whose failure can be
# stepped over by punctuation, is not a check. This is the same claim
# CLAUDE.md's Doors section makes about every other door.
#
# NOT A GATE. The build and the test suites are still unproven after
# this passes, and a DB-backed test cannot run here at all. It promises
# that a lint, a formatting slip or a CLIPPY error will not be
# discovered by a pod.
#
# CLIPPY EARNED ITS PLACE HERE on 2026-08-28, when a car went red on
# clippy alone — two unused imports left behind by a refactor — costing
# a gate and a re-gate, about 22 minutes of cluster time. --quick had
# passed and was right to: it never compiled anything. Clippy runs over
# the workspace when the tree implies a crate, dependents included
# (4669e9d7), and is skipped when it implies none; on a cold target it
# and the pins pay for a build, and the escape hatches below are the
# answer if that is ever the wrong trade.
#
# ESCAPE HATCHES, deliberately two and deliberately loud:
#   git push --no-verify      # git's own, skips every hook
#   BOSS_SKIP_PREFLIGHT=1     # skips this hook only, and says so
set -u

if [ "${BOSS_SKIP_PREFLIGHT:-0}" = "1" ]; then
    echo "pre-push: pre-flight SKIPPED by BOSS_SKIP_PREFLIGHT=1" >&2
    exit 0
fi

# A push that only deletes refs carries no content to check.
only_deletes=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    if [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
        only_deletes=0
    fi
done
if [ "$only_deletes" = "1" ]; then
    exit 0
fi

root="$(git rev-parse --show-toplevel)"
if [ ! -x "$root/infra/gate.sh" ]; then
    echo "pre-push: infra/gate.sh not found or not executable — not blocking the push" >&2
    exit 0
fi

echo "pre-push: running the pre-flight (minutes: 561 s warm when a crate changed, measured 2026-10-18; skip with BOSS_SKIP_PREFLIGHT=1)" >&2
if "$root/infra/gate.sh" --lint; then
    exit 0
fi

cat >&2 <<'MSG'

pre-push: REFUSED — the pre-flight failed.

  These are the checks that need no database, and every one of them
  would otherwise be found by a gate: a gate and a re-gate of cluster
  time to learn something answerable here in minutes.

  Fix them, or push with BOSS_SKIP_PREFLIGHT=1 if you have a reason.
MSG
exit 1

[Unit]
Description=Reap the containers and volumes of crashed CI jobs
Documentation=file:/opt/boss/infra/forge/reap-dead-ci-jobs.sh
After=docker.service
Requires=docker.service

[Service]
# The system of record for the wrap pair, from /etc/boss/sor.env —
# rendered by install.sh from infra/estate/estate.toml. This unit failed
# every run on 2026-09-03 for want of an address; the per-unit drop-in
# that fixed it is retired for the one file (backlog 5222163e).
EnvironmentFile=/etc/boss/sor.env
Type=oneshot
# The script sudos to docker if it has to; running as root avoids that
# and keeps the unit's failure modes to the script's own.
User=root
# Job visibility. The forge host has no /opt/boss — it runs from
# this checkout, which is where the installed units already point.
# THE TOKEN'S HEADER FILE NEVER OUTLIVES A RUN (backlog df38075a, F1;
# the second car, which took the class and not the six units the item
# named). The wrap pair on the Exec lines below presents the machine
# token, and infra/lib/secret-header.sh makes its 0600 header file in
# $RUNTIME_DIRECTORY when a unit declares one: /run/reap-dead-ci-jobs,
# tmpfs, 0700, this unit's account's, removed by systemd when this
# oneshot stops whatever ended it. Without it the file was made in the
# host's shared /tmp, where a killed run left it. The reasoning is in
# infra/forge/estate-observe-units.service; the pin that walks every
# unit is a_killed_sender_leaves_no_header_behind.rs.
RuntimeDirectory=reap-dead-ci-jobs
RuntimeDirectoryMode=0700
ExecStartPre=-/var/lib/boss/tree/current/infra/boss-maintenance-wrap.sh maintenance-reap-ci-jobs "Reap dead CI jobs"
ExecStart=/var/lib/boss/tree/current/infra/forge/reap-dead-ci-jobs.sh
ExecStopPost=-/var/lib/boss/tree/current/infra/boss-step.sh maintenance-reap-ci-jobs run

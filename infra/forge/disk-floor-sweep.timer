# Hourly, not the converge's 10min. Above the floor a pass now prunes
# the per-train CI images past their window — at 5-14 trains a day that
# is one or two images an hour, and an hour of cadence keeps the pile
# bounded at a few images rather than a day's worth. Below the floor the
# sweep frees tens of GB in one pass, still well ahead of the
# ~1GB-per-converge growth rate.
[Unit]
Description=BOSS forge disk floor sweep (hourly)

[Timer]
OnBootSec=5min
OnUnitActiveSec=1h

[Install]
WantedBy=timers.target

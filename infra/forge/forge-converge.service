[Unit]
Description=BOSS forge host adopts its own infra/forge + infra/ops units from forge main
Wants=network-online.target
After=network-online.target

[Service]
# The system of record comes from /etc/boss/sor.env, which install.sh
# — run by THIS unit — renders from infra/estate/estate.toml (backlog
# 5222163e). Optional (`-`) here and nowhere else: the converge is the
# arm that writes the file, so it must start on a host that does not
# have it yet. On that first tick the wrap pair below has no address and
# files nothing (both are `-`); the run still converges, the file is
# there for the next tick, and every other unit on the host reads it
# hard. Until 2026-09-18 the address was pinned inline on these lines
# and once more in a per-unit drop-in install.sh wrote — reap failed on
# 2026-09-03 for want of exactly that (there was no drop-in yet).
EnvironmentFile=-/etc/boss/sor.env
Type=oneshot
# Root: install.sh writes /etc/systemd/system. The script itself drops
# to the checkout owner (runuser -l) for the git operations, so the
# clone never accumulates root-owned objects.
User=root
# WHICH NODE THIS IS in the estate registry, so the converge can read
# its own roles off /api/estate/nodes (infra/estate/roles.toml maps them
# to what the host installs). Declared here, not read from a hostname.
Environment=BOSS_NODE_ID=forge
# WHAT THE RUN LEAVES FOR ITS PACKET — one path, declared once, for two
# processes: ExecStart (this script and install.sh under it) writes
# structured facts here, ExecStopPost (boss-step.sh) merges them onto the
# `run` step and deletes the file. Every Exec line inherits Environment=,
# so producer and consumer cannot disagree about the path (CLAUDE.md §9a),
# and /run being tmpfs means a reboot cannot leave a stale one.
Environment=BOSS_RUN_SUMMARY_FILE=/run/forge-converge.summary.json
# install.sh is fast (file copies + daemon-reload); the git fetch is the
# only slow part and is a shallow main fetch. A generous ceiling in case
# the forge is briefly unreachable.
TimeoutStartSec=10min
#
# THE FORGE TOKEN'S HEADER NEVER OUTLIVES ITS RUN (backlog 359a811c,
# 2026-09-28). forge-converge.sh writes the Authorization header
# protect-main.sh and offsite-push.sh read into $RUNTIME_DIRECTORY: tmpfs
# under /run, 0700, which systemd removes when this oneshot run stops —
# after the SIGKILL the ceiling above sends second too — and a power loss
# clears. Until this line it lived under the host's shared /tmp and
# survived both. Without the directory the script writes no header,
# skips its two readers and ends 78 — but still runs install.sh, so a
# tick of the new script under an older copy of this unit installs this
# line and the next tick runs clean (never a whole-run refusal: that
# would wedge the converge out of installing its own repair).
# LimitCORE=0: no git or curl of this run dumps a core holding it. The
# same shape as boss-ops-runner.service (5f77b205).
#
# NEVER PrivateTmp=, ProtectSystem=, ReadOnlyPaths= or any other option
# that gives this unit a mount namespace. This unit IS the host's
# installer: install.sh, run under it, writes /etc/systemd/system,
# /etc/boss/sor.env and /usr/local/bin, and the owner's git moves the
# checkout every other unit runs from. ProtectSystem= or ReadOnlyPaths=
# would fail those writes outright and leave every unit landed but never
# installed — the class this converge exists to close. The rest each give
# the run a mount namespace, which systemd.exec(5) says will "disconnect
# propagation of mounts from the unit's processes to the host": the
# unit whose job is changing the host would see it through a view of its
# own. RuntimeDirectory= creates no namespace. Pinned by
# crates/core/boss-testing/tests/ops_runner_unit_keeps_the_host_mount_namespace.rs.
RuntimeDirectory=forge-converge
RuntimeDirectoryMode=0700
LimitCORE=0
# The timer is the executor; the Job is the visibility. ExecStartPre
# opens (or reuses) the maintenance-forge-converge packet; ExecStopPost
# records the verdict whether ExecStart succeeded or not, so a failed
# converge closes its packet "Maintenance failed" — the alarm, naming
# the exit status. (timers-leave-a-packet) ExecStartPre=- since
# 2026-09-18: this converge renders the address file the wrap reads, so
# on a host that has no file yet the wrap refuses (exit 78) and the
# converge must run anyway — the packet is visibility, never a
# precondition (CLAUDE.md §Diagnosis; boss-gcp-converge is the same).
ExecStartPre=-/var/lib/boss/tree/current/infra/boss-maintenance-wrap.sh maintenance-forge-converge "Forge host converges on its own units"
# WHAT THIS UNIT STARTS IS THE LAUNCHER, NOT A TREE (backlog a604a35b).
# Root's converge runs from the tree root fetched from the forge's own
# repository (/var/lib/boss/tree, infra/forge/root-tree.sh) and no longer
# from /home/david/boss, a checkout its owner can write. The converge is
# also the thing that MOVES that tree, so which generation's script a
# tick runs is decided by a root-owned copy outside it: the newest
# generation, or — when that one has run twice without showing it can
# bring in the next — the last one that did. infra/forge/
# forge-converge-launch.sh is that file and carries the rule; install.sh
# puts it here and installs this unit only once it is there. The wrap
# and the step ride `-`, so a tree that is briefly not there costs this
# run its packet and never its start.
ExecStart=/usr/local/libexec/boss/forge-converge-launch
ExecStopPost=-/var/lib/boss/tree/current/infra/boss-step.sh maintenance-forge-converge run

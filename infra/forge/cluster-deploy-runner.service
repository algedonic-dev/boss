[Unit]
Description=BOSS cluster converges on forge main (build + push + roll)

[Service]
Type=oneshot
User=david
# The build is a cached docker build (~minutes warm, ~an hour cold).
TimeoutStartSec=90min
# Job visibility. The forge host has no /opt/boss — it runs from
# this checkout, which is where the installed units already point.
ExecStartPre=/home/david/boss/infra/boss-maintenance-wrap.sh maintenance-cluster-converge "Cluster converge on forge main"
ExecStart=/home/david/boss/infra/forge/cluster-deploy-runner.sh
ExecStopPost=-/home/david/boss/infra/boss-step.sh maintenance-cluster-converge run

[Unit]
Description=Boss messages_events retention sweep
After=postgresql.service

[Service]
# BOSS_JOBS_URL from /etc/boss/sor.env, rendered on this host from
# infra/estate/estate.toml (backlog 5222163e) — the one spelling.
EnvironmentFile=/etc/boss/sor.env
Type=oneshot
Environment=RUST_LOG=info
# THE TOKEN'S HEADER FILE NEVER OUTLIVES A RUN (backlog df38075a, F1;
# the second car, which took the class and not the six units the item
# named). The wrap pair on the Exec lines below presents the machine
# token, and infra/lib/secret-header.sh makes its 0600 header file in
# $RUNTIME_DIRECTORY when a unit declares one: /run/boss-messages-events-purge,
# tmpfs, 0700, this unit's account's, removed by systemd when this
# oneshot stops whatever ended it. Without it the file was made in the
# host's shared /tmp, where a killed run left it. The reasoning is in
# infra/forge/estate-observe-units.service; the pin that walks every
# unit is a_killed_sender_leaves_no_header_behind.rs.
RuntimeDirectory=boss-messages-events-purge
RuntimeDirectoryMode=0700
ExecStartPre=-/opt/boss/infra/boss-maintenance-wrap.sh maintenance-messages-purge "messages_events retention sweep"
ExecStart=/usr/local/bin/boss-messages-events-purge --config /etc/boss-messages-api.toml
ExecStopPost=-/opt/boss/infra/boss-step.sh maintenance-messages-purge run
# Runs as root to match the rest of the boss-*-api units on
# bare-metal Boss deployments. The DELETE itself authenticates to
# Postgres via the `boss` role/password in postgres_url, not the
# Linux user. Tighten to a dedicated service user once Boss adopts
# per-service Linux UIDs system-wide.

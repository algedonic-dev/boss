[Unit]
Description=Boss revenue-recognition scheduler (ASC 606 step 3)
After=postgresql.service

[Service]
# BOSS_JOBS_URL from /etc/boss/sor.env, rendered on this host from
# infra/estate/estate.toml (backlog 5222163e) — the one spelling.
EnvironmentFile=/etc/boss/sor.env
Type=oneshot
# The binary + config + env-var gate for RuleSet v2. Operators on
# pre-switchover deployments leave BOSS_LEDGER_RULESET unset (default
# is v1); no recognition facts fire because the schedule-populating
# path also lives behind v2. Once flipped, every downstream service
# that posts finance facts must carry the same env var or v1-tagged
# entries will race v2-tagged ones.
Environment=RUST_LOG=info
Environment=BOSS_LEDGER_RULESET=2
# What the run DID reaches its packet (backlog 18d6a6c9, 2026-09-17):
# the binary writes {considered, recognized, closed, locked_skips,
# errors} here and the ExecStopPost closer merges it onto the run
# step under result=. Declared once so both Exec lines agree on the
# path (infra/run-summary.sh). Until this the packet said result=ok
# alone, so a tick over an empty revenue_schedules table read exactly
# like one that recognized a year.
Environment=BOSS_RUN_SUMMARY_FILE=/run/boss-ledger-recognize.summary.json
ExecStartPre=/opt/boss/infra/boss-maintenance-wrap.sh maintenance-ledger-recognize "Revenue-recognition run"
ExecStart=/usr/local/bin/boss-ledger-recognize --config /etc/boss-ledger-api.toml
ExecStopPost=-/opt/boss/infra/boss-step.sh maintenance-ledger-recognize run
# Runs as root to match boss-ledger-api.service + the
# boss-messages-events-purge / boss-audit-integrity-check
# timer pattern. The recognize binary authenticates to
# Postgres via the `boss` role in postgres_url, not via Linux
# UID. Tighten to a dedicated service user once Boss adopts
# per-service Linux UIDs system-wide.

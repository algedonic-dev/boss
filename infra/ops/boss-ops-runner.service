# The ops-request runner (packet 729329c6, PULL half): answers
# host-side debug reads filed as packets, so nobody sshes and pastes.
#
# NOBODY INSTALLS THIS BY HAND ANY MORE, and this comment used to be
# the two recipes for doing so. Both hosts that run it now converge it
# from one definition — infra/ops/install-ops-runner.sh, called by
# infra/forge/install.sh (forge) and by `deploy-services.sh units`
# (boss-gcp). A hand-installed unit is one rebuild from gone, which is
# exactly how the forge nearly lost this door (packet 4d5f158a).
#
# THIS FILE IS HOST-AGNOSTIC and installed byte-identical everywhere.
# Identity and checkout come from the per-host drop-in that installer
# writes (`Environment=HOST_ID=<estate node id>` plus a cleared-and-
# overridden ExecStart). Deliberately no HOST_ID default: a runner that
# guessed which host it speaks for would answer another host's packets,
# so with no drop-in the script refuses and systemd records the unit
# red — a state somebody notices.
[Unit]
Description=BOSS ops: answer ops-request packets filed against this host
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# BOSS_JOBS_URL pinned INLINE on the Exec line, exactly like
# boss-estate-observe-host.service and for the same reason:
# deploy-services' shared jobs-url.conf drop-in points the timer fleet
# at the legacy 127.0.0.1 instance (91ddebfb) and drop-in env wins over
# unit env — env(1) on the Exec line outranks both. The script itself
# refuses to run without an explicit BOSS_JOBS_URL (no default; the
# boss-step.sh lesson, 2026-08-17).
#
# No boss-maintenance-wrap pair, deliberately: this fires every minute
# and a packet per firing would drown the board. Its product IS
# packets — the ops-requests it answers — and its failure modes are
# this unit going red plus a filed packet aging visibly unanswered.
#
# Every host's drop-in REPLACES this line with the runner from its own
# checkout; the path below is only what a host whose checkout is
# /opt/boss would get. The URL is the same on both, because the system
# of record is one place.
ExecStart=/usr/bin/env BOSS_JOBS_URL=http://10.20.0.34:7900 /opt/boss/infra/ops/ops-runner.sh

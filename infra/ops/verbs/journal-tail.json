{
  "about": "last N journal lines of one unit (default 100, max 200)",
  "hosts": [
    "boss-gcp",
    "forge"
  ],
  "argv": [
    "journalctl",
    "-u",
    "{1}",
    "-n",
    "{2}",
    "--no-pager"
  ],
  "params": [
    {
      "name": "unit",
      "pattern": "^[A-Za-z0-9@._][A-Za-z0-9@._-]*$"
    },
    {
      "name": "lines",
      "pattern": "^[0-9]{1,3}$",
      "default": "100",
      "max": 200
    }
  ]
}

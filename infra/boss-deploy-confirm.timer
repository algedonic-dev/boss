[Unit]
Description=BOSS deploy confirm — dead-man readings at +2m and +8m after a generation flip

[Timer]
# Armed by deploy-services.sh via `systemctl restart` at the symlink
# flip, which resets the monotonic clock: the service fires at +2m
# (reading 1) and +8m (reading 2, the verdict). The delayed second
# reading is what catches the boots-clean-dies-later class.
OnActiveSec=2min
OnActiveSec=8min
# The default 1min accuracy window is a third of the first interval —
# tighten so "+2m" means +2m.
AccuracySec=15s
# Not Persistent: the readings are relative to a flip, not to wall
# time. Boot activates the timer anyway (WantedBy), so a reboot that
# interrupted an unconfirmed window still gets its standing state
# evaluated at boot+2m — with no marker pending, the run is a no-op.
Persistent=false

[Install]
WantedBy=timers.target

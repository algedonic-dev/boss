[Unit]
Description=Evidence lands near the event — 10-minute reconcile between the twice-daily windows

[Timer]
# Frequent by design and cheap when idle (one API read + one gh
# poll): the stage-duration measurements and the notify_on_done
# alerts are only as honest as reconcile's cadence. Boarding stays
# with the 06:00/18:00 windows — this timer never opens a PR, so
# the ~2/day budget is untouched. A Davids-merge lands within ten
# minutes instead of waiting for a human to fire the conductor.
OnCalendar=*-*-* *:00/10:00 UTC
Persistent=false
RandomizedDelaySec=30

[Install]
WantedBy=timers.target

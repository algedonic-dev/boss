[Unit]
Description=BOSS train conductor — cadence loop (rules fire the verbs; systemd keeps the process alive)
Documentation=file:/opt/boss/docs/design/protocol-cadence.md
# No postgresql.service here: the loop holds no database connection
# of its own — everything rides the jobs API (see BOSS_JOBS_URL below).
After=network-online.target boss-clock-api.service boss-jobs-api.service
Wants=network-online.target

# HOST ENV CONTRACT — this unit is not complete on its own. The env
# VALUES (tokens, urls) are box-local and ride in drop-ins
# (/etc/systemd/system/boss-train.service.d/*.conf, e.g. forge.conf +
# jobs-sor.conf); the CONTRACT is documented here so a fresh host
# cannot half-configure the conductor without noticing:
#
#   BOSS_TRAIN_FORGE=forgejo — which forge adapter drives PRs, merges
#       and branch deletes. Unset, the conductor falls back to the
#       `gh` GitHub adapter: on the 2026-08-13 cadence cutover that
#       fallback pointed a whole window at GitHub instead of the
#       forge until a drop-in patched it.
#   BOSS_TRAIN_FORGE_URL / BOSS_TRAIN_FORGE_REPO /
#   BOSS_TRAIN_FORGE_TOKEN_FILE — where the forge lives, which repo,
#       and the repo-scoped token file (default
#       /etc/boss-train/forge.token).
#   BOSS_JOBS_URL — the jobs SYSTEM OF RECORD, and REQUIRED: the
#       cadence loop refuses to start without it (backlog a516f1f1).
#       It is the loop's one door — rules, last-firings, firing
#       claims, outcomes and the dock probe all ride /api/cadence/*
#       and /api/jobs on this address. The loop's old private
#       Postgres pool recorded firings in a DIFFERENT database than
#       the one operators read, so last-firing answered "never
#       fired" for every rule while the loop fired on schedule.
#       Preflight still goes red on any loopback jobs URL unless
#       BOSS_TRAIN_ALLOW_LOCAL_JOBS=1 is set — the deliberate
#       test/demo-box escape hatch; never set it on a box whose
#       system of record lives elsewhere.
#   BOSS_ACTOR=automation:train-conductor — WHO THIS LOOP SIGNS AS.
#       Every jobs-API write it makes carries this id, and the system
#       of record stamps it into the audit log and the step's
#       `completed_by`. The conductor's verbs default to this id in
#       code (boss-cli `identity::CONDUCTOR`), so an unset var is
#       still correct here; setting it states the automation identity
#       instead of inheriting it. Every OTHER verb — `boss gate`,
#       `boss prove`, `boss job` — signs the actor RUNNING it and
#       refuses a write when nothing names them, because signing an
#       operator's act as this automation is what backlog 5083d6f5
#       measured on a step.
#   (BOSS_TRAIN_AUTO_MERGE=1, BOSS_TRAIN_DEPLOY_REMOTE, … ride the
#   same drop-ins.)
#
# infra/deploy-services.sh installs THIS file only; it never writes
# or removes anything under boss-train.service.d/, so host drop-ins
# survive every deploy.

[Service]
# The scheduling knowledge that used to live in this directory's two
# timers (06:00/18:00 boarding, 10-minute reconcile) is now rows in
# the cadence_rules registry (infra/postgres/schema/114-cadence-rules.sql):
# each rule names the `boss train` verb it fires, its basis
# (wall | clock | queue-depth) and parameters. This unit is what
# remains for the OS to do — keep the executor alive. Changing the
# train's cadence is a registry edit, not a unit-file edit.
#
# The loop evaluates rules against boss-clock time, claims a
# deterministic firing row per window (exactly-once across restarts
# and instances), and runs the verb as a child of the same binary —
# so the conductor's flock, journal lines, and exit codes behave
# exactly as they did under the timers.
#
# A verb runs BESIDE the loop, not inside it: a reconcile that
# deploys can take 30+ minutes, and awaiting it inline used to stop
# every other rule AND the heartbeat for that whole window (job
# 9c5871fa). Ticks now keep evaluating while a verb runs, with one
# in-flight run per rule; overlap between different rules is settled
# by the conductor's own flock, which is what it was always for.
# On stop, the loop waits BOSS_TRAIN_CADENCE_DRAIN_SECONDS (default
# 30, comfortably inside systemd's 90s TimeoutStopSec) for in-flight
# verbs and journals any that outlast it — a cut-short run is a
# claimed firing row with no rc.
User=david
# /var/lib/boss-train — the conductor's own clone + lock live here,
# never in the dev working tree.
StateDirectory=boss-train
# Run IN the conductor's clone: the verb children (git, gates) act on
# the cwd's repo, and on cutover night the unit ran at /opt/boss —
# outside the clone — until a host drop-in re-pointed it. The `-`
# tolerates the pre-first-boarding hole: the cadence loop itself is
# cwd-independent and the boarding verb creates the clone; without
# the dash a fresh host's unit would fail CHDIR forever and never
# get the chance to create it.
WorkingDirectory=-/var/lib/boss-train/repo
ExecStart=/usr/local/bin/boss train cadence
Environment=RUST_LOG=info
# Restart=ALWAYS, not on-failure: this is a supervisor loop, and a
# loop that exits CLEANLY still leaves the yard unconducted — measured
# 2026-09-02: a clean exit at ~08:15Z stopped deploys, converges,
# boardings and alarms for six hours, and systemd's on-failure saw
# nothing to heal. Any exit is a failure of supervision.
Restart=always
RestartSec=10
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target

[Unit]
Description=Twice-daily PR train (the ~2-PRs-a-day cadence, as a schedule not a discipline)

[Timer]
# Two windows: end of the working morning and end of the day, UTC.
OnCalendar=*-*-* 06,18:00:00 UTC
# A missed window (box down, deploy in flight) fires on the next boot
# rather than silently skipping the train.
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target

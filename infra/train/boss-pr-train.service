[Unit]
Description=BOSS PR train conductor — batch ready branches into one PR, record evidence
Documentation=file:/opt/boss/infra/train/conductor.sh
After=network-online.target boss-jobs-api.service
Wants=network-online.target

[Service]
Type=oneshot
User=david
# /var/lib/boss-train — the conductor's own clone + lock live here,
# never in the dev working tree.
StateDirectory=boss-train
WorkingDirectory=/opt/boss
ExecStart=/opt/boss/infra/train/conductor.sh
# Reconcile + assembly are quick; a deploy phase (build-release +
# deploy-services) is not. Generous, and the flock makes overlap safe.
# 2h, not 45min: a train touching boss-jobs rebuilds nearly the whole
# workspace, and 45min killed the #226 deploy mid-build on a busy box
# (2026-08-10 19:45, item 45498fc9). The flock makes an overlapping
# run exit clean, so a long build delays the next window - it never
# piles up.
TimeoutStartSec=2h

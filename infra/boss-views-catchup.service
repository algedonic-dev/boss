# Managed by infra/gcp/install-units.sh — edits will be overwritten.
[Unit]
Description=Boss event_facts catch-up (project audit_log rows past the watermark)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
# BOSS_JOBS_URL from /etc/boss/sor.env, rendered on this host from
# infra/estate/estate.toml (backlog 5222163e) — the one spelling.
EnvironmentFile=/etc/boss/sor.env
Type=oneshot
Environment=RUST_LOG=info
Environment=BOSS_POSTGRES_URL=postgres://boss:boss@127.0.0.1/boss
ExecStartPre=/opt/boss/infra/boss-maintenance-wrap.sh maintenance-views-catchup "event_facts catch-up"
ExecStart=/usr/local/bin/boss-views-catchup
ExecStopPost=-/opt/boss/infra/boss-step.sh maintenance-views-catchup run
User=david

[Install]
WantedBy=multi-user.target

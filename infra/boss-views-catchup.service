# Managed by infra/deploy-services.sh — edits will be overwritten.
[Unit]
Description=Boss event_facts catch-up (project audit_log rows past the watermark)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=RUST_LOG=info
Environment=BOSS_POSTGRES_URL=postgres://boss:boss@127.0.0.1/boss
ExecStart=/usr/local/bin/boss-views-catchup
User=david

[Install]
WantedBy=multi-user.target

# The codebase as an estate scope (0a5df32d): nightly size/breakdown
# series so incidental complexity shows as a trend, not a surprise.
# Install on boss-gcp (same conductor op as observe-host):
#   sudo install -m644 infra/codebase-observe/boss-observe-codebase.{service,timer} /etc/systemd/system/
#   sudo install -m755 infra/codebase-observe/observe-codebase.sh /usr/local/lib/boss/observe-codebase.sh
#   sudo systemctl daemon-reload && sudo systemctl enable --now boss-observe-codebase.timer
[Unit]
Description=BOSS codebase observation: size and per-unit breakdown, nightly
Wants=network-online.target
After=network-online.target

[Service]
# JOBS_API from /etc/boss/sor.env, rendered on this host from
# infra/estate/estate.toml (backlog 5222163e).
EnvironmentFile=/etc/boss/sor.env
Type=oneshot
Environment=CLONE_DIR=/var/lib/boss-train/repo
ExecStart=/usr/local/lib/boss/observe-codebase.sh

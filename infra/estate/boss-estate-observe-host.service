# The host half of the estate observation loop (a5d14977). Installed
# on boss-gcp by install-units.sh (roles.toml row). The forge host runs
# the SAME pair with two overrides, installed by hand until its
# config-not-in-repo debt is paid:
#   sudo install -m644 infra/estate/boss-estate-observe-host.{service,timer} /etc/systemd/system/
#   sudo mkdir -p /etc/systemd/system/boss-estate-observe-host.service.d
#   printf '[Service]\nEnvironment=HOST_ID=forge\n' | sudo tee /etc/systemd/system/boss-estate-observe-host.service.d/host.conf
#   sudo systemctl daemon-reload && sudo systemctl enable --now boss-estate-observe-host.timer
[Unit]
Description=BOSS estate: observe this host and record what was there
Wants=network-online.target
After=network-online.target

[Service]
EnvironmentFile=/etc/boss/sor.env
Type=oneshot
# THE TOKEN'S HEADER FILE NEVER OUTLIVES A RUN (backlog df38075a, F1 of
# review a92c0b94). No User=: a system unit under /etc/systemd/system
# (infra/gcp/install-units.sh), so this runs as root. The wrap pair and
# the observer's post present the machine token boss-gcp has held since
# train #980; the 0600 header file infra/lib/secret-header.sh hands curl
# is made in $RUNTIME_DIRECTORY when a unit declares one —
# /run/boss-estate-observe-host, tmpfs, 0700, root's — and systemd
# removes it when this oneshot stops whatever ended it. Without it the
# file sat in the host's shared /tmp, where a killed tick left it.
RuntimeDirectory=boss-estate-observe-host
RuntimeDirectoryMode=0700
Environment=HOST_ID=boss-gcp
# The timers-leave-a-packet pair: a timer with no Job trail fails
# silently, which is the exact class this observer exists to end.
# The system of record and JOBS_API come from /etc/boss/sor.env
# (EnvironmentFile= under [Service]), rendered on this host from
# infra/estate/estate.toml — the one spelling (backlog 5222163e). Until
# 2026-09-18 both were pinned inline, against a drop-in that pointed the
# timer fleet at the retired second stack (91ddebfb): EnvironmentFile=
# outranks any Environment= drop-in, so the file does the pin's job.
ExecStartPre=-/opt/boss/infra/boss-maintenance-wrap.sh maintenance-estate-observe-host "estate host observation"
ExecStart=/opt/boss/infra/estate/observe-host.sh
ExecStopPost=-/opt/boss/infra/boss-step.sh maintenance-estate-observe-host run

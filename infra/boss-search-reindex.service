# Managed by infra/gcp/install-units.sh — edits will be overwritten.
[Unit]
Description=Boss search_index rebuild (global search projection)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
# BOSS_JOBS_URL from /etc/boss/sor.env, rendered on this host from
# infra/estate/estate.toml (backlog 5222163e) — the one spelling.
EnvironmentFile=/etc/boss/sor.env
Type=oneshot
Environment=RUST_LOG=info
Environment=BOSS_POSTGRES_URL=postgres://boss:boss@127.0.0.1/boss
ExecStartPre=/opt/boss/infra/boss-maintenance-wrap.sh maintenance-search-reindex "search_index rebuild"
ExecStart=/usr/local/bin/boss-search-reindex
ExecStopPost=-/opt/boss/infra/boss-step.sh maintenance-search-reindex run
User=david

[Install]
WantedBy=multi-user.target

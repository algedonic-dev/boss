[Unit]
Description=Boss file_refs garbage-collection sweep
After=postgresql.service

[Service]
# BOSS_JOBS_URL from /etc/boss/sor.env, rendered on this host from
# infra/estate/estate.toml (backlog 5222163e) — the one spelling.
EnvironmentFile=/etc/boss/sor.env
Type=oneshot
Environment=RUST_LOG=info
# THE TOKEN'S HEADER FILE NEVER OUTLIVES A RUN (backlog df38075a, F1;
# the second car, which took the class and not the six units the item
# named). The wrap pair on the Exec lines below presents the machine
# token, and infra/lib/secret-header.sh makes its 0600 header file in
# $RUNTIME_DIRECTORY when a unit declares one: /run/boss-files-gc,
# tmpfs, 0700, this unit's account's, removed by systemd when this
# oneshot stops whatever ended it. Without it the file was made in the
# host's shared /tmp, where a killed run left it. The reasoning is in
# infra/forge/estate-observe-units.service; the pin that walks every
# unit is a_killed_sender_leaves_no_header_behind.rs.
RuntimeDirectory=boss-files-gc
RuntimeDirectoryMode=0700
ExecStartPre=-/opt/boss/infra/boss-maintenance-wrap.sh maintenance-files-gc "file_refs garbage collection"
ExecStart=/usr/local/bin/boss-files-gc --config /etc/boss-content-api.toml
ExecStopPost=-/opt/boss/infra/boss-step.sh maintenance-files-gc run
# Inherits the same elevated-on-bare-metal posture as the other
# Boss timer-driven binaries. The Postgres connection authenticates
# via the `boss` role baked into postgres_url; file bytes live under
# the local-disk `root` in /etc/boss-content-api.toml's [files] block
# (must be readable+writable by this unit's user).

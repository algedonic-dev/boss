[Unit]
Description=Boss ML — daily infer-batch trigger
After=network-online.target boss-ml-api.service
Requires=boss-ml-api.service

[Service]
EnvironmentFile=/etc/boss/sor.env
Type=oneshot
User=boss
# The packet goes to the SYSTEM OF RECORD — /etc/boss/sor.env
# (EnvironmentFile= above), rendered on this host from
# infra/estate/estate.toml (backlog 5222163e). deploy-services'
# jobs-url.conf drop-in used to point this unit at boss-gcp's local
# instance, which carried only the three kinds baked into registry.rs —
# this kind lives in the platform bundle, seeded on the cluster alone —
# so the wrap got `400 unknown or inactive job kind` every night from
# 2026-08-17 to 2026-09-08 (backlog e109f57e), and the batch below never
# ran. The fix was env(1) on the Exec line (91ddebfb); EnvironmentFile=
# outranks a drop-in the same way. The `-` is the other half: the packet is
# VISIBILITY, never a precondition — 23 nights of stale predictions
# were the price of an ExecStartPre that could refuse the run.
# The ML API itself stays local: it works this host's database
# (/etc/boss-ml-api.toml, postgres://127.0.0.1/boss).
ExecStartPre=-/opt/boss/infra/boss-maintenance-wrap.sh maintenance-ml-inference-batch "ML inference batch"
ExecStart=/opt/boss/infra/ml/run-inference-batch.sh
ExecStopPost=-/opt/boss/infra/boss-step.sh maintenance-ml-inference-batch run
Environment=BOSS_ML_API_URL=http://127.0.0.1:7070
StandardOutput=journal
StandardError=journal

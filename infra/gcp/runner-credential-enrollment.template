# INERT exact-purpose proposal for the separate prepare-a-deposit-key enroll
# step. This file is not read by converge and installs no privilege or key.
# The recorded presence-assured enrollment must bind account, receiver host,
# public key, purpose and exact installation record before sender activation.
# Do not substitute the existing kubeconfig receiver or break-glass key.

# Preserve this root-owned hierarchy so the receiver's sibling library reads
# have the same source identity as the reviewed tree:
# /usr/local/libexec/boss/runner-delivery/infra/gcp/runner-credential-recv.sh
# /usr/local/libexec/boss/runner-delivery/infra/lib/runner-delivery-ack.sh
# /usr/local/libexec/boss/runner-delivery/infra/lib/jq.sh
# /usr/local/libexec/boss/runner-delivery/infra/lib/secret-header.sh
# /usr/local/libexec/boss/runner-delivery/infra/lib/sor.sh
# /usr/local/libexec/boss/runner-delivery/infra/lib/sor-reader.sh
# /usr/local/libexec/boss/runner-delivery/infra/boss-api-curl.sh
# Root-owned /etc/boss/sor.env supplies the existing system-of-record address.
# jq, bash, coreutils and curl are explicit runtime dependencies.

# Proposed sudoers command, NO arguments, under normal env_reset:
@ENROLLED_ACCOUNT@ ALL=(root) NOPASSWD: /usr/local/libexec/boss/runner-delivery/infra/gcp/runner-credential-recv.sh

# Proposed authorized_keys entry, using ONLY the broker-prepared public key
# named by the completed exact-purpose enrollment. It accepts no client
# command, agent forwarding, network forwarding, PTY or environment override:
restrict,command="exec sudo -n /usr/local/libexec/boss/runner-delivery/infra/gcp/runner-credential-recv.sh" @ENROLLED_PUBLIC_KEY@

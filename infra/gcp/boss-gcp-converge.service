# boss-gcp adopts its own systemd units from forge main (408c81f6).
#
# The boss-gcp deploy hop retired with the 2026-09-04 conductor cutover
# and nothing replaced it, so every unit authored or FIXED after that day
# sat inert on main: the five-minute estate unit observer last filed a
# packet ON the cutover day, the hourly conservation-invariants timer
# last filed one on 2026-08-19, and the ML inference batch has never
# filed one at all. Same disease the forge host had, same cure
# (infra/forge/forge-converge.service is the sibling).
#
# ONE-TIME BOOTSTRAP — the hand action that ends the hand actions. Run
# once on boss-gcp, as root; idempotent, and the `units` mode installs
# THIS unit pair among the rest, so it never needs repeating:
#
#   cd /opt/boss && git fetch forge main && git merge --ff-only FETCH_HEAD \
#     && sudo ./infra/gcp/install-units.sh units
[Unit]
Description=BOSS boss-gcp adopts its own systemd units from forge main
Documentation=file:/opt/boss/infra/gcp/boss-gcp-converge.sh
Wants=network-online.target
After=network-online.target

[Service]
# The system of record comes from /etc/boss/sor.env, which THIS unit's
# converge renders from infra/estate/estate.toml before it installs
# anything (backlog 5222163e). Optional (`-`) here and in forge-converge
# only: the converge is the arm that writes the file, so it must start
# on a host that does not have it yet; on that first tick the wrap pair
# below has no address and files nothing (both are `-`), and every other
# unit on the host reads the file hard.
EnvironmentFile=-/etc/boss/sor.env
Type=oneshot
# Root: install-units.sh writes /etc/systemd/system. The script drops
# to the checkout's owner for every git operation, so /opt/boss never
# accumulates root-owned objects.
User=root
# The whole run is one shallow fetch of main, file copies, a
# daemon-reload — and, when main moved, one pull of the cluster image's
# CLI layer over HTTP (install-cli-from-image.sh bounds that pull to
# 6 min itself, so a hung pull is a named failure on the packet rather
# than this ceiling). A generous ceiling in case the forge is briefly
# unreachable.
TimeoutStartSec=10min
# WHAT THE RUN LEAVES FOR ITS PACKET — one path, declared once, for two
# processes. `ExecStart=` (the converge and every installer under it)
# writes structured facts here; `ExecStopPost=` (boss-step.sh) merges them
# onto the `run` step and deletes the file. systemd gives every Exec line
# this Environment=, so the two halves cannot disagree about the path
# (CLAUDE.md §9a). /run is tmpfs, so a reboot cannot leave a stale one
# either. Before this, the packet said `result=ok` and nothing else, and
# on 2026-09-11 that was enough to support a wrong conclusion about what
# the converge had installed — see infra/run-summary.sh.
Environment=BOSS_RUN_SUMMARY_FILE=/run/boss-gcp-converge.summary.json
# WHICH NODE THIS IS in the estate registry, so the converge can read
# its own roles off /api/estate/nodes (infra/estate/roles.toml maps them
# to units). This unit file lives under infra/gcp/ and installs on this
# one host, so the id is declared rather than guessed from a hostname.
Environment=BOSS_NODE_ID=boss-gcp
# Until 2026-09-18 the address was pinned inline with env(1) on these
# lines, against deploy-services' shared jobs-url.conf drop-in that
# pointed the timer fleet at the retired second stack (4ef79606,
# 91ddebfb). EnvironmentFile= outranks any Environment= drop-in, so the
# file does the pin's job.
#
# ExecStartPre=- because the packet is VISIBILITY, NEVER A PRECONDITION.
# An arm that needs the patient is not an arm: boss-ml-inference-batch
# lost 23 nights to a hard ExecStartPre, and on 2026-09-05 the cluster
# converge could not run at all because its own packet-opener refused.
# A converge that cannot be seen still converges.
ExecStartPre=-/opt/boss/infra/boss-maintenance-wrap.sh maintenance-boss-gcp-converge "boss-gcp adopts its own units"
ExecStart=/opt/boss/infra/gcp/boss-gcp-converge.sh
ExecStopPost=-/opt/boss/infra/boss-step.sh maintenance-boss-gcp-converge run

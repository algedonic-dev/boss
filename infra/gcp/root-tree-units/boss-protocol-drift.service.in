# Dormant replacement: ca356c79 / fe6d1124. Not installed by any caller.
# Activate only after the root fetch credential and tree handover are proven.
[Unit]
Description=BOSS daily protocol drift against the live workflow registry
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/boss/sor.env
Environment=BOSS_WRAP_OPEN_RETRY=3
WorkingDirectory=/var/lib/boss/gcp-tree/current
RuntimeDirectory=boss-protocol-drift
RuntimeDirectoryMode=0700
TimeoutStartSec=10min
ExecStartPre=-/var/lib/boss/gcp-tree/current/infra/gcp/root-tree.sh run infra/boss-maintenance-wrap.sh maintenance-protocol-drift "Protocol drift"
ExecStart=/var/lib/boss/gcp-tree/current/infra/gcp/root-tree.sh run infra/protocol-drift.sh file --repo .
ExecStopPost=-/var/lib/boss/gcp-tree/current/infra/gcp/root-tree.sh run infra/boss-step.sh maintenance-protocol-drift run

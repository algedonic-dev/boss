#!/usr/bin/env bash
# boss — the BOSS CLI on the dev pod's PATH.
#
# The pod image ships no `boss`; the binary is a build artifact in
# CARGO_TARGET_DIR (/scratch/target), so a bare shell — and David's
# `!` prompt in a session — could not find it (2026-09-07 23:05 UTC,
# a train cancel that mattered). This shim execs a CLI and defaults
# BOSS_JOBS_URL to the system of record, the way the conductor's unit
# does.
#
# Why it lives HERE and not only on the pod (backlog f199c188,
# 2026-09-14): it was pod-local text under /work/tools/bin —
# unversioned, untested, absent from any fresh pod or builder pod —
# and it decides WHICH binary answers every `boss` verb; a stale one
# answered `boss --version` wrong through it once already. Same shape
# as wt-cargo (34b29b52) and boss-api (0d8d7a90): the file is
# versioned and pinned (crates/core/boss-testing/tests/boss_shim_sh.rs),
# and the pod's /work/tools/bin/boss is a symlink to this file in the
# operator's checkout.
#
# WHICH CLI ANSWERS, AND HOW OLD IT IS (backlog c35eda6c, retro
# 27fad542, 2026-09-18). The retro counted the pod's CLI rebuilt by
# hand THREE times in one window — `git merge --ff-only origin/main`
# then `cargo build -p boss-cli` — because a landed car had changed
# what the CLI validates locally (the ops verbs directory compiled
# into it, gate flags, orient sections), and a stale build refused a
# valid four-argument sweep at 12:5xZ with `takes 3 arg(s), got 4`.
# This shim exec'd it and said nothing about its age. Measured that
# day: /scratch/target/debug/boss built from 6286857f (#448) while
# origin/main stood at cb053ed6 (#450). Two candidates now:
#
#   * THE IMAGE CLI — the tree's CLI by construction. The reclaim
#     sidecar's hourly pass (infra/cluster/dev-scratch-reclaim.sh)
#     takes /usr/local/bin/boss out of the cluster image the deploy
#     runner built for origin/main, with the estate's installer
#     (infra/estate/install-cli-from-image.sh, the same one boss-gcp
#     and the forge run), into <store>/<sha>/boss with `current`
#     linked at the sha. It is run through the store's copy of
#     infra/estate/boss-cli-wrapper.sh, which hands the binary its
#     commit as BOSS_BUILD_COMMIT — the image's binary is compiled
#     without git and says `built from unknown` run bare. The store is
#     /work/tools/image-cli on the pod (the sidecar has no root and
#     /usr/local/bin is its own overlay; /work is the shared mount).
#   * THE BUILD — the newer of target/release/boss and target/debug/
#     boss by mtime (a fixed order is how a days-old release build beat
#     every morning's debug build, the built_from car, 2026-09-14). Its
#     `--version` names the commit it was compiled from (built_from.rs).
#
# The image CLI at origin/main wins; a build at or after origin/main
# runs silently; `--built` as the first argument (or BOSS_SHIM_BUILT
# set) asks for the build outright — a developer testing a branch —
# and is consumed here, never passed on. A candidate BEHIND origin/main,
# or one that cannot say what it was built from, is the packet's fix
# (a): a READ verb runs under one WARNING line naming both shas and the
# fix; a WRITE verb is REFUSED with the same facts and exit 78, the code
# publish-workflow.sh uses for a binary that cannot say what it was
# built from — a stale binary that refuses a valid verb, or accepts a
# stale shape, names nothing. The reads are a closed list below;
# everything else is a write, so a verb this list does not know fails
# closed.
#
# THE SHIM RUNS THE DOOR IT USED TO NAME (backlog 49d9e99d, 2026-09-18).
# Measured three times in one session and five across the day: a train
# lands between the sidecar's hourly ticks, and every builder whose
# build spans it is refused at the one moment it matters — its gate
# launch — with a refusal naming a ten-second, idempotent, mechanical
# fix (`dev-scratch-reclaim.sh --cli`); the operator's own gate sat 25
# min behind a wait loop for the same reason. CLAUDE.md: mechanical
# operations belong to the machine. So before refusing a write the
# shim runs that same leg itself and reads its STATUS, never its prose:
# 0 — the tree's CLI is confirmed in the store; `current` is re-read
#     and the write runs on it, under one line saying so (the merge
#     observed, never assumed: a confirm that did not land `current`
#     on origin/main is still a refusal);
# 75 — not yet: the deploy runner builds the image a few minutes after
#     each train and it is not in the registry. The shim WAITS for it —
#     re-runs the leg on a poll, bounded, one line per attempt (backlog
#     f0bb99c1, the block at the install below) — and at the bound the
#     refusal stands and says how long ago origin/main landed (its
#     committer epoch against now — integers, never ISO strings) so the
#     caller looks at the late image rather than rebuilds;
# anything else — the installer refused (registry dark, digest
#     mismatch): its complete output rides the refusal, the only copy.
# Reads keep their warning and install nothing; `--built` asked for
# the build and is refused as before, since the image CLI is a
# different binary than the one asked for. BOSS_SHIM_INSTALLER
# replaces the leg (a test stubs it; the leg's own pin is
# dev_scratch_reclaim_sh.rs), and the store the leg fills is handed
# to it as BOSS_CLI_STORE — the one the shim reads (CLAUDE.md §9a).
#
# origin/main is read from THIS checkout's remote-tracking ref (the
# shim lives in the operator's clone, which the startup protocol
# fetches), never from the forge on every call: a dark forge must not
# take every `boss` verb down with it, and `boss orient` already
# measures the live head. The comparison is git's: current iff
# origin/main is an ancestor of (or equal to) what the candidate was
# built from.
#
# The roots are overridable so the test never touches the pod's:
#   BOSS_SHIM_TARGET_ROOT=/some/dir   the build's root (/scratch)
#   BOSS_SHIM_IMAGE_STORE=/some/dir   the image store (/work/tools/image-cli)
#   BOSS_SHIM_INSTALLER=/some/exe     the install leg (dev-scratch-reclaim.sh --cli)
#   BOSS_SHIM_CLI_WAIT=<seconds>      the longest a write waits for the image (900; 0 = refuse at once)
#   BOSS_SHIM_CLI_POLL=<seconds>      how often it re-runs the leg meanwhile (30)
#   BOSS_SHIM_VERBOSE=1               say which candidate ran, and its sha
#
# The system of record has ONE spelling, in `sor-url` beside this
# script (boss-api reads the same file); readlink -f because the pod
# reaches this through a symlink. A caller's BOSS_JOBS_URL is kept.
here="$(dirname "$(readlink -f "$0")")"

# AND THIS FILE'S OWN AGE (backlog 0b36dd65, 2026-09-19). Everything
# above judges the BINARY; this shim is itself a symlink target in the
# operator's checkout, which nothing keeps on origin/main — measured
# two commits behind for most of one day. A stale shim can be missing
# the very rules below. It WARNS and runs, for a read and a write
# alike: refusing a write here would refuse `boss gate`, and a builder
# refused at its gate launch is the failure counted five times in one
# day in backlog 49d9e99d — worse than the stale answer it prevents.
# The binary check keeps its own refusal, because the binary is what
# decides what a verb does.
if [ -r "$here/door-freshness.sh" ]; then
  # shellcheck source=door-freshness.sh
  . "$here/door-freshness.sh"
  if shim_stale="$(door_is_stale "$0")"; then
    echo "boss: WARNING — $shim_stale" >&2
  fi
fi

if [ -z "${BOSS_JOBS_URL:-}" ]; then
  if [ -s "$here/sor-url" ]; then
    BOSS_JOBS_URL="$(tr -d '[:space:]' < "$here/sor-url")"
  else
    echo "boss: BOSS_JOBS_URL is unset and $here/sor-url names no system of record — a copy of this shim without its sor-url has no default" >&2
    exit 2
  fi
fi
export BOSS_JOBS_URL

prefer=image
if [ "${1:-}" = "--built" ]; then prefer=build; shift; fi
[ -n "${BOSS_SHIM_BUILT:-}" ] && prefer=build

store="${BOSS_SHIM_IMAGE_STORE:-/work/tools/image-cli}"
target="${BOSS_SHIM_TARGET_ROOT:-/scratch}/target"
repo="$(dirname "$(dirname "$here")")"
install="bash $repo/infra/cluster/dev-scratch-reclaim.sh --cli"
rebuild="cargo build -p boss-cli"

main="$(git -C "$here" rev-parse --verify -q refs/remotes/origin/main 2>/dev/null || true)"

# The image CLI: the generation `current` names, run through the wrapper.
image_sha="$(readlink "$store/current" 2>/dev/null || true)"
if [ -n "$image_sha" ] && [ -x "$store/boss" ] && [ -x "$store/$image_sha/boss" ]; then
  image_bin="$store/boss"
else
  image_bin=""; image_sha=""
fi

# The build: the newer profile, and what it says it was built from —
# `boss <crate> built from <sha>` (built_from.rs), first line taken in
# the shell, the sed that publish-workflow.sh reads it with.
build_bin=""
for b in "$target/release/boss" "$target/debug/boss"; do
  [ -x "$b" ] || continue
  if [ -z "$build_bin" ] || [ "$b" -nt "$build_bin" ]; then build_bin="$b"; fi
done
build_sha=""
if [ -n "$build_bin" ]; then
  line="$("$build_bin" --version 2>&1)"
  line="${line%%$'\n'*}"
  build_sha="$(printf '%s\n' "$line" | sed -n 's/.*built from \([0-9a-f]\{7,40\}\|unknown\).*/\1/p')"
fi

# current <sha>: origin/main is an ancestor of, or is, the sha.
current() {
  [ -n "$main" ] && [ -n "$1" ] && [ "$1" != unknown ] \
    && git -C "$here" merge-base --is-ancestor "$main" "$1" 2>/dev/null
}

run=""; run_sha=""; how=""
case "$prefer" in
  image) order="image build" ;;
  build) order="build" ;;
esac
for c in $order; do
  case "$c" in
    image) [ -n "$image_bin" ] && current "$image_sha" && { run="$image_bin"; run_sha="$image_sha"; how="the image CLI"; } ;;
    build) [ -n "$build_bin" ] && current "$build_sha" && { run="$build_bin"; run_sha="$build_sha"; how="the build"; } ;;
  esac
  [ -n "$run" ] && break
done

if [ -n "$run" ]; then
  if [ -n "${BOSS_SHIM_VERBOSE:-}" ]; then
    if [ "$run_sha" = "$main" ]; then rel="= origin/main"; else rel="ahead of origin/main ${main:0:8}"; fi
    echo "boss: running $how at ${run_sha:0:8} ($rel) — $run" >&2
  fi
  exec "$run" "$@"
fi

# Nothing current. The candidate that answers is the one asked for, or
# the newer of the two by ancestry; then the age rule decides.
if [ "$prefer" = build ]; then
  run="$build_bin"; run_sha="$build_sha"; how="the build"
elif [ -n "$image_bin" ] && [ -n "$build_bin" ]; then
  if [ -n "$build_sha" ] && [ "$build_sha" != unknown ] && git -C "$here" merge-base --is-ancestor "$image_sha" "$build_sha" 2>/dev/null; then
    run="$build_bin"; run_sha="$build_sha"; how="the build"
  else
    run="$image_bin"; run_sha="$image_sha"; how="the image CLI"
  fi
elif [ -n "$image_bin" ]; then
  run="$image_bin"; run_sha="$image_sha"; how="the image CLI"
else
  run="$build_bin"; run_sha="$build_sha"; how="the build"
fi
if [ -z "$run" ]; then
  echo "boss: no built binary under $target and no image CLI under $store — the hourly reclaim pass installs the tree's CLI from the cluster image (run it now: $install), or: $rebuild" >&2
  exit 127
fi

# Is this a read? `--help` anywhere is; so is no verb at all.
read_verb=""
case "${1:-}" in
  ""|--version|-V|--help|-h|help|orient|brief|receipt|merged|running|doctor|channels|inspect|queue) read_verb=1 ;;
esac
for a in "$@"; do case "$a" in --help|-h) read_verb=1 ;; esac; done

case "$run_sha" in
  ""|unknown) why="$run cannot say what it was built from ('${line:-}' names no commit)" ;;
  *) why="$run is built from ${run_sha:0:8} but origin/main is ${main:0:8} — $how is behind the tree" ;;
esac
fix="install the tree's CLI from the cluster image ($install, ~10s; the reclaim sidecar does this hourly) or rebuild: $rebuild"
if [ -n "$read_verb" ]; then
  echo "boss: WARNING — $why; a read runs, a write would be refused. Fix: $fix" >&2
  [ -n "${BOSS_SHIM_VERBOSE:-}" ] && echo "boss: running $how at ${run_sha:-unknown} (behind origin/main ${main:0:8}) — $run" >&2
  exec "$run" "$@"
fi
refused="a write verb (${1}) is not run from a CLI that is not the tree's"
still="Reads (orient, brief, receipt, …) still run under a warning."

# A write, and the caller did not ask for the build: run the install
# leg and read its status (the block above says why).
#
# AND WAIT AT THE DOOR WHILE IT SAYS NOT YET (backlog f0bb99c1,
# 2026-09-23). The not-yet refusal was correct and had no verb behind
# it, so three people hand-rolled the same wait in two days: a builder
# slept seven minutes and retried, the operator wrote an until-loop on
# the store's `current`, a triager wrapped three calls in a 40-attempt
# poll. The condition is local and the action is to wait — mechanical,
# so the machine's. While the leg answers 75 the shim re-runs it every
# BOSS_SHIM_CLI_POLL seconds (30), one line per attempt naming the sha
# it waits for and when it gives up, for at most BOSS_SHIM_CLI_WAIT
# seconds (900; 0 refuses at once, the old behaviour). The bound is a
# measurement, not a hope: on 2026-09-23 the pod's store shows the image
# for a train installed 3 and 8 minutes after its merge, so fifteen
# covers the deploy runner with room — and a wait past it is a late
# image to look at, not a wait to extend, so it ends in the same loud
# refusal, saying how long it waited. A value that is not a whole
# number is refused rather than guessed (a poll of 0 would spin).
wait_s="${BOSS_SHIM_CLI_WAIT:-900}"
poll_s="${BOSS_SHIM_CLI_POLL:-30}"
if [ "$prefer" != build ] && [ -n "$main" ]; then
  case "$wait_s" in
    ''|*[!0-9]*) echo "boss: BOSS_SHIM_CLI_WAIT='$wait_s' is not a whole number of seconds — the longest this shim waits for the tree's CLI (unset: 900; 0: refuse at once)" >&2; exit 64 ;;
  esac
  case "$poll_s" in
    ''|*[!0-9]*|0) echo "boss: BOSS_SHIM_CLI_POLL='$poll_s' is not a whole number of seconds above 0 — how often this shim re-runs the install leg while it waits (unset: 30)" >&2; exit 64 ;;
  esac
  if [ $((wait_s % 60)) -eq 0 ]; then bound="$((wait_s / 60)) min"; else bound="${wait_s}s"; fi
  landed_age() {
    local landed
    landed="$(git -C "$here" log -1 --format=%ct "$main" 2>/dev/null || true)"
    case "$landed" in
      ''|*[!0-9]*) echo "origin/main ${main:0:8} landed at a time git could not read" ;;
      *) echo "origin/main ${main:0:8} landed $(( ($(date +%s) - landed) / 60 )) min ago" ;;
    esac
  }
  echo "boss: $why — installing the tree's CLI at ${main:0:8} from the cluster image ($install) before running ${1}" >&2
  # The link follows the store: <tools>/image-cli -> <tools>/bin/boss-image,
  # the leg's own default for the pod's paths — so a scratch store never
  # relinks the pod's boss-image (a rehearsal did, 2026-09-19).
  link="$(dirname "$store")/bin/boss-image"
  started="$(date +%s)"
  while :; do
    log="$(mktemp "${TMPDIR:-/tmp}/boss-shim-install.XXXXXX")"
    rc=0
    if [ -n "${BOSS_SHIM_INSTALLER:-}" ]; then
      BOSS_CLI_STORE="$store" BOSS_CLI_LINK="$link" "$BOSS_SHIM_INSTALLER" >"$log" 2>&1 || rc=$?
    else
      REPO_DIR="${REPO_DIR:-$repo}" BOSS_CLI_STORE="$store" BOSS_CLI_LINK="$link" \
        bash "$repo/infra/cluster/dev-scratch-reclaim.sh" --cli >"$log" 2>&1 || rc=$?
    fi
    [ "$rc" -eq 75 ] || break
    now="$(date +%s)"
    [ $((now + poll_s - started)) -le "$wait_s" ] || break
    rm -f "$log"
    echo "boss: waiting — the image for ${main:0:8} is not in the registry yet ($(landed_age); the deploy runner builds it a few minutes after each train). Retrying in ${poll_s}s, then running ${1}; gives up after $bound, $((now - started))s waited so far (BOSS_SHIM_CLI_WAIT=0 refuses at once)." >&2
    sleep "$poll_s"
  done
  waited=$(( $(date +%s) - started ))
  case "$rc" in
    0)
      rm -f "$log"
      image_sha="$(readlink "$store/current" 2>/dev/null || true)"
      if [ -n "$image_sha" ] && [ -x "$store/boss" ] && [ -x "$store/$image_sha/boss" ] && current "$image_sha"; then
        [ -n "${BOSS_SHIM_VERBOSE:-}" ] && echo "boss: running the image CLI at ${image_sha:0:8} (installed just now) — $store/boss" >&2
        exec "$store/boss" "$@"
      fi
      echo "boss: REFUSED — $why; $refused. The install leg confirmed, but $store/current is ${image_sha:-none}, not at origin/main ${main:0:8} — the store and the leg disagree; look at $store before retrying. $still" >&2
      exit 78 ;;
    75)
      rm -f "$log"
      if [ "$wait_s" -eq 0 ]; then
        echo "boss: REFUSED — $why; $refused. Ran $install: not yet — the image for ${main:0:8} is not in the registry; $(landed_age), and the deploy runner builds the image a few minutes after each train. Wait and retry (this shim installs it then, and waits for it itself with BOSS_SHIM_CLI_WAIT unset); a rebuild ($rebuild) takes longer than the wait. $still" >&2
      else
        echo "boss: REFUSED — $why; $refused. Ran $install until the bound: not yet — waited ${waited}s (BOSS_SHIM_CLI_WAIT=$wait_s) and the image for ${main:0:8} never reached the registry; $(landed_age), and the deploy runner builds it a few minutes after each train, so an image this late is the deploy runner's to look at, not a wait to extend. $still" >&2
      fi
      exit 78 ;;
    *)
      sed 's/^/boss:   cli: /' "$log" >&2
      rm -f "$log"
      echo "boss: REFUSED — $why; $refused. Ran $install: exit $rc — its complete output is above. Fix: $fix. $still" >&2
      exit 78 ;;
  esac
fi
echo "boss: REFUSED — $why; $refused. Fix: $fix. $still" >&2
exit 78

#!/usr/bin/env bash
# Dev isolation (b3071bf4): with a selector, candidate code runs only in
# the worker; a selector naming no activated generation REFUSES (design
# a68fc42a D1), never runs it here beside the token.
# A caller the store is closed to (root-owned 0700; uid 65534 under
# infra/dev/as-gate-uid.sh) cannot see the selector either way, so that
# is a refusal too, never the held state (backlog 1fddbe13; the reasoning
# is in infra/dev/run-while-held.sh).
dev_control=/work/tools/dev-control
seen=$dev_control
until [[ -e $seen || -L $seen ]]; do seen=${seen%/*}; seen=${seen:-/}; done
if [[ -e $dev_control/enabled || -L $dev_control/enabled ]]; then
    [[ "$(/usr/bin/readlink -- "$dev_control/enabled")" =~ ^"$dev_control"/generations/[0-9a-f]{40}$ ]] && exec "$dev_control/wt-cargo" "$@"
    echo "wt-cargo: REFUSED — dev isolation is on and its selector $dev_control/enabled names no activated generation, so candidate code does not run beside this container's credentials (design a68fc42a D1). Why: $dev_control/activation.log. boss-api and boss without --built still run." >&2
    exit 75
elif [[ ! -d $seen || ! -x $seen ]]; then
    echo "wt-cargo: REFUSED — this caller (uid $EUID) cannot read the dev isolation store $dev_control ($seen is closed to it), so it cannot tell whether isolation is on, and candidate code does not run beside this container's credentials (design a68fc42a D1). Run it as the store's owner." >&2
    exit 75
fi
# wt-cargo — run cargo in a WORKTREE with its own target dir, seeded by
# reflink from the warm shared one (bottleneck #6, 2026-09-12).
#
# Why: one shared /scratch/target across worktrees meant every switch
# recompiled the touched crates and boss-testing's tree-match guard
# (3d8bb6e6) refused binaries built from a neighbour; and one 16 GiB
# cgroup meant one build at a time. /scratch is XFS with reflink: a
# 30 GB target copies in ~7 s for zero bytes, so each worktree can have
# its own, and builds can run two at a time with -j capped.
#
# Why it lives HERE and not only on the pod (backlog 34b29b52,
# 2026-09-14): it was pod-local text under /work/tools/bin with its own
# copy of the cargo bound, and the copy drifted (8, against
# infra/dev/pod-build.env's 6) — CLAUDE.md §9a, one layer down from the
# file that says so. Now the bound is SOURCED from pod-build.env, the
# script is versioned and pinned (crates/core/boss-testing/tests/
# wt_cargo_sh.rs), and the pod's /work/tools/bin/wt-cargo is a symlink
# to this file in the operator's checkout.
#
# Usage: wt-cargo <cargo args…>        (run from inside the worktree)
#        WT_JOBS=8 wt-cargo test -p boss-cli
#        wt-cargo suite <crate>         (the whole suite, in chunks that
#                                        fit a tool call; run it until it
#                                        exits 0 — wt-cargo-suite.sh)
# The seed is the SHARED checkout's own target — the dir wt_target_dir
# names for the main checkout this worktree hangs off, /scratch/
# target-boss on the pod, kept warm by the operator's builds there; the
# per-worktree dir is /scratch/target-<worktree-basename>. Both are
# overridable (WT_SEED, WT_TARGET_ROOT) so the test never touches
# /scratch; the defaults are the pod's.
set -euo pipefail
here=$(dirname "$(readlink -f "$0")")

# AND THIS FILE'S OWN AGE (backlog 0b36dd65, 2026-09-19). The symlink
# under /work/tools/bin resolves into the operator's checkout, which
# nothing keeps on origin/main; a stale wt-cargo bounds a build by
# yesterday's rule. It warns and builds — a builder stopped mid-run by
# a door is worse than a build at the wrong -j — and the warning names
# the ten-second fix.
if [ -r "$here/door-freshness.sh" ]; then
    # shellcheck source=door-freshness.sh
    . "$here/door-freshness.sh"
    if stale=$(door_is_stale "$0"); then
        echo "wt-cargo: WARNING — $stale" >&2
    fi
fi

root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "wt-cargo: not in a git worktree" >&2; exit 2; }

# A RUN DOES NOT BUILD IN THE SHARED CHECKOUT (backlog 916fe290). Measured
# 2026-10-09, four builders in four runs: an isolated-worktree agent's
# Bash call starts in the dispatching session's checkout (/work/boss),
# and the harness DROPS a leading `cd <worktree> &&` from the command
# text, so cargo, git and once a relative-path sed ran there — silently,
# every command answering from the wrong tree. So when BOSS_AGENT_RUN
# names a run, the main checkout that worktrees hang off is refused
# before any target is seeded. Shared is judged by shape, not by a typed
# path: git-dir equals git-common-dir (a main checkout, not a linked
# worktree) AND worktrees are registered under it — a lone clone, the
# run's own worktree, and the operator naming no run all build. `boss
# gate` refuses the same case (crates/orchestrators/boss-cli/src/
# shared_checkout.rs), pinned by wt_cargo_sh.rs here.
agent_run=${BOSS_AGENT_RUN:-}
if [ -n "${agent_run//[[:space:]]/}" ]; then
    git_dir=$(git rev-parse --path-format=absolute --git-dir 2>/dev/null) || git_dir=
    common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || common_dir=
    if [ -n "$git_dir" ] && [ "$git_dir" = "$common_dir" ] \
        && [ -n "$(ls -A "$common_dir/worktrees" 2>/dev/null)" ]; then
        {
            echo "wt-cargo: REFUSED — BOSS_AGENT_RUN=$agent_run names an agent run, and this shell is in $root, the SHARED checkout: the main checkout worktrees hang off and every door on this host runs from, not a worktree of the run's own (backlog 916fe290)."
            echo 'An isolated-worktree agent'\''s Bash call starts here, and its harness drops a leading `cd <worktree> &&` from the command text, so a cd written that way never ran.'
            echo 'Run wt-cargo from a script you wrote whose first lines are `cd <your worktree> || exit 1` and `pwd`, by absolute path, and read the pwd in its log;'
            echo "git -C $root worktree list names every worktree. An operator building this checkout on purpose unsets BOSS_AGENT_RUN."
        } >&2
        exit 2
    fi
fi
name=$(basename "$root")
# THE NAME IS READ, NOT TYPED (backlog 955c99b6, 2026-09-22). gate.sh
# now checks into this same dir rather than the shared one, so the
# spelling lives once — in the helper beside this script — and the two
# cannot drift into a --lint that reads a dir no build ever wrote.
# shellcheck source=wt-target-dir.sh
. "$here/wt-target-dir.sh" || { echo "wt-cargo: $here/wt-target-dir.sh could not be read — the per-worktree target dir has no name to read; refusing to build into a shared one" >&2; exit 2; }
dir=$(wt_target_dir "${WT_TARGET_ROOT:-/scratch}" "$root")

# THE SEED IS READ THE SAME WAY (backlog b6bbe177, 2026-10-20). It was
# a typed /scratch/target, and on the pod nothing had written that dir
# for weeks: the shared checkout builds through this door too, into
# the dir the helper names for it, /scratch/target-boss (4.6 GB). So
# every builder and reviewer target started cold — minutes and 8-18 GB
# a run, ~30 runs that night. The seed is now the helper's answer for
# the main checkout this worktree hangs off (the parent of git's common
# dir), so the warm dir and the seed cannot be two names again. In the
# main checkout itself that is its own dir, which needs no seed.
common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || common=$root/.git
seed=${WT_SEED:-$(wt_target_dir "${WT_TARGET_ROOT:-/scratch}" "$(dirname "$common")")}

# THE BUILD HOLDS ITS TARGET (backlog 94cd0c23, 0c18deed, 2026-09-27).
# A green gate frees the run's target (boss-cli scratch_target.rs), and
# a green is one car's, not the worktree's: run 9770e6b1's car-1 green
# took 66 of 168 test binaries out from under car 2's running suite,
# and on 2026-09-27 a green freed 59 GiB while another run compiled in
# this same worktree. So this door holds the target's lock SHARED on
# fd 8 from here to cargo's exit — the seed, the count pass, and the
# `exec` below, which keeps the descriptor, so every rustc and test
# binary holds it too — and the free, which takes it EXCLUSIVE without
# waiting, keeps a target it cannot lock. Taken BEFORE the seed, so a
# free never removes a half-seeded dir either. A free already removing
# the dir holds it exclusive: this build waits for it, says so, and
# then seeds afresh below rather than building into a dir being deleted.
lock=$(wt_target_lock "${WT_TARGET_ROOT:-/scratch}" "$root")
mkdir -p "$(dirname "$lock")"
if command -v flock >/dev/null 2>&1 && { exec 8>>"$lock"; } 2>/dev/null; then
    if ! flock -s -n 8; then
        echo "wt-cargo: waiting for $lock — a green's scratch free is removing this worktree's target; this build seeds afresh once it is done" >&2
        flock -s 8
    fi
else
    echo "wt-cargo: WARNING — could not hold $lock (no flock, or the file cannot be opened), so a green's scratch free cannot see this build and may remove its target mid-run" >&2
fi

if [ ! -d "$dir" ]; then
    if [ -d "$seed" ]; then
        # The copy lands in a sibling temp name and is renamed into
        # place only once it is whole (backlog 08782b71, 2026-09-14).
        # Under set -e a cp that died part-way — a non-reflink
        # filesystem, a full disk, a kill — used to leave a PARTIAL
        # $dir; the next run saw the directory, skipped the seed, and
        # built against a half-copied target it believed warm, with
        # no message naming it. A stale temp dir from a killed run is
        # cleared first; a failed copy is cleared, named (cp's exit
        # code), and $dir starts cold exactly as if there were no seed.
        #
        # EVERY SEEDED FILE IS BACKDATED before the rename (backlog
        # 1150c518, 2026-09-28). cp -a keeps mtimes, and cargo trusts a
        # path crate's artifact whose dep-info is NEWER than its
        # sources, while the artifact's identity (the -C metadata hash)
        # leaves the workspace path out. So a seed built AFTER this
        # worktree was checked out, from a revision where a path crate
        # reads differently, was taken as this tree's own build: analyst
        # run d666c988 measured a first build print value=1 from a tree
        # whose source says 2, no Compiling line, and the second run
        # too. Dated to the epoch, every seeded artifact is older than
        # every source, so each path crate is rebuilt from THIS tree;
        # registry crates are fingerprinted by version, not mtime, and
        # stay warm. Touching forward, or copying without -a, both still
        # printed value=1 (run c51f125b, 2026-09-26). A backdate that
        # fails is a seed that cannot be trusted: it is cleared and the
        # target starts cold, exactly like a failed copy. The hazard is
        # live, not latent (da1d903f): the seed is the shared checkout's
        # own target (b6bbe177), rebuilt there while worktrees exist.
        tmp=$dir.seeding
        rm -rf "$tmp"
        start=$(date +%s)
        rc=0
        why=
        cp -a --reflink=always "$seed" "$tmp" || { rc=$?; why="cp exit $rc"; }
        if [ "$rc" -eq 0 ]; then
            find "$tmp" -exec touch -h -d @1 {} + || { rc=$?; why="backdating exit $rc"; }
        fi
        if [ "$rc" -eq 0 ]; then
            mv "$tmp" "$dir"
            echo "wt-cargo: seeded $dir from $seed by reflink in $(( $(date +%s) - start ))s, every file backdated so cargo rebuilds each path crate from this tree" >&2
        else
            rm -rf "$tmp"
            mkdir -p "$dir"
            echo "wt-cargo: seed from $seed failed ($why) — $dir starts cold" >&2
        fi
    else
        mkdir -p "$dir"
        echo "wt-cargo: no seed at $seed — $dir starts cold" >&2
    fi
fi
export CARGO_TARGET_DIR="$dir"

# THE FLOOR FOLLOWS THE BUILD (backlog 3f2a08ab, 2026-09-24). The dev
# pod was evicted with the reclaim sidecar's 25% scratch floor in force:
# the sidecar reads the floor hourly, and w-1 went from above it to the
# kubelet's 15% line in under 27 minutes (the gate receipts' free_gb,
# 284 GiB at 00:53Z to 136 at the 01:27Z eviction). Builds are what
# fill /scratch, so each one runs the floor's sibling pass first — the
# sidecar's own script, in its `--scratch-floor` mode, whose comment
# has the measurement and why the floor, not the pod's priority, is
# what keeps this pod alive. Above the floor it is one df and silent.
#
# The pass is handed THIS door's scratch root and the SEED as the
# primary: CARGO_TARGET_DIR was just re-pointed at this worktree's dir
# above, and handed through, the pass would read the warm seed — the
# shared checkout's target — as a sibling it may take. This worktree's own target is
# touched first, because the pass takes idle targets oldest first and a
# builder that read code for half an hour holds an idle one — it must
# not be taken the moment before it builds. A failed pass is named and
# the build goes on: the hourly pass reports a floor it cannot meet.
#
# THE PASS SIGNS WHAT IT FILES (review fb78c7b0 of car 099f8a9f, F7;
# backlog ffd309c1). A pass that acts files a maintenance packet through
# the wrap and step helpers, and their reader looks for the token at
# its default directory — which the dev container does not mount, on
# purpose: builders run tests here, and every stamping client a test
# builds reads that default. So the pass filed its packets with no
# token (twice in the review alone, ce62d977 and 6ed3e993). This is a
# door, and a door names the doors' directory — ./machine-token-dir —
# and the record's host to what it runs, as the shim and boss-api do:
# to this ONE child, on its command line, never exported. cargo is not
# told, because every test binary a build runs inherits cargo's
# environment. A caller's own directory, or host list (even empty), is
# kept, as the shim keeps them.
touch "$dir"
floor_env=("SCRATCH_MOUNT=${WT_TARGET_ROOT:-/scratch}" "CARGO_TARGET_DIR=$seed")
if [ -z "${BOSS_MACHINE_TOKEN_DIR:-}" ] && [ -s "$here/machine-token-dir" ]; then
    floor_env+=("BOSS_MACHINE_TOKEN_DIR=$(tr -d '[:space:]' < "$here/machine-token-dir")")
fi
if [ -z "${BOSS_MACHINE_TOKEN_HOSTS+set}" ] && [ -s "$here/sor-url" ]; then
    token_host=$(tr -d '[:space:]' < "$here/sor-url")
    token_host=${token_host#*://}
    token_host=${token_host%%[/?#]*}
    token_host=${token_host##*@}
    token_host=${token_host%%:*}
    floor_env+=("BOSS_MACHINE_TOKEN_HOSTS=$token_host")
fi
reclaim=${WT_RECLAIM:-$here/../cluster/dev-scratch-reclaim.sh}
if [ -f "$reclaim" ]; then
    rrc=0
    env "${floor_env[@]}" bash "$reclaim" --scratch-floor >&2 || rrc=$?
    [ "$rrc" -eq 0 ] || echo "wt-cargo: WARNING — the scratch-floor pass exited $rrc; building anyway" >&2
else
    echo "wt-cargo: WARNING — no scratch-floor pass at $reclaim; /scratch is watched only hourly" >&2
fi

# THE BOUND IS READ, NOT TYPED. pod-build.env is the one home of the
# pod's cargo job count; it sits beside this script, and the symlink
# under /work/tools/bin is resolved so the checkout it points at is the
# one consulted. A missing file is refused rather than defaulted: an
# unbounded cargo here is 32 jobs against a 16 GiB cgroup, which is the
# failure pod-build.env exists to prevent. `here` is resolved at the
# top of the file, beside the freshness check.
env_file=$here/pod-build.env
[ -f "$env_file" ] || { echo "wt-cargo: $env_file is missing — the cargo bound has no home to read; refusing to build unbounded" >&2; exit 2; }
set -a; . "$env_file"; set +a
[ -n "${CARGO_BUILD_JOBS:-}" ] || { echo "wt-cargo: $env_file sets no CARGO_BUILD_JOBS; refusing to build unbounded" >&2; exit 2; }

# The pod is one 8-CPU / 16 GiB cgroup shared with David's interactive
# session. Measured 2026-09-14: two builders + the operator compiling
# at once throttled the cgroup 2,177 periods (~10 min) and he felt it
# as lag. A BUILDER worktree (.claude/worktrees/agent-*) therefore
# builds 4-wide and nice'd, so the interactive shell wins the scheduler
# when they collide; the operator's own worktrees keep the pod bound
# (infra/dev/pod-build.env, sourced above). WT_JOBS overrides either.
# The width is wt-target-dir.sh's wt_build_jobs, because gate.sh's
# pre-flight checks a worktree at the same width (backlog 9ecd12ea).
CARGO_BUILD_JOBS=$(wt_build_jobs "$root" "$CARGO_BUILD_JOBS")
export CARGO_BUILD_JOBS
case "$name" in
    agent-*) runner=(nice -n 10 cargo) ;;
    *)       runner=(cargo) ;;
esac

# `wt-cargo suite <crate>` — the crate's whole suite in chunks that each
# fit a builder's ten-minute tool call, resumable across calls (backlog
# ede6245a; the measurement and the design are in the helper). It runs
# here, after the target, its lock and the bound are set, so every chunk
# builds under the same door as any other cargo call. Under set -e a
# nonzero return exits with that status.
if [ "${1:-}" = suite ]; then
    shift
    # shellcheck source=wt-cargo-suite.sh
    . "$here/wt-cargo-suite.sh" || { echo "wt-cargo: $here/wt-cargo-suite.sh could not be read" >&2; exit 2; }
    wt_suite "$@"
    exit $?
fi

# SAY HOW MANY TEST BINARIES THE RUN MUST REACH, BEFORE IT REACHES ANY
# (backlog 3566f5b4, 2026-09-22). Measured that day: `cargo test -p
# boss-jobs --all-features` reaches 148 test binaries in 11m20s on this
# pod — longer than the ten-minute window a builder's tool call gets.
# Cut off at that mark the output holds 125 `Running` lines, no failure
# and no final `test result:` summary, which is indistinguishable from a
# green suite; the eleven binaries sorting at or after waiting_on_pg.rs
# never ran, and the car went to the gate twice on one-line stale
# expectations in two of them. cargo stops at the first FAILING binary
# too (`--no-fail-fast` runs the rest), and that at least exits 101.
#
# Counting the `Running` lines was always possible; the total to count
# them against was what nobody had, and it has to be printed BEFORE the
# run or the same truncation eats it. `cargo test --no-run` prints one
# `Executable` line per test binary and the run then prints one
# `Running` line per binary — measured equal at 148 — and it is the
# build the run needs anyway, so this costs a warm no-op.
#
# Only a whole-crate suite run: a `--` splits harness arguments, where
# `--no-run` would land on libtest instead of cargo.
sub=""
for a in "$@"; do case "$a" in -*) ;; *) sub=$a; break ;; esac; done
count_pass=yes
[ "$sub" = test ] || count_pass=no
for a in "$@"; do case "$a" in --|--no-run|--list|--doc|-h|--help) count_pass=no ;; esac; done

if [ "$count_pass" = yes ]; then
    # Streamed, not captured: a cold build is minutes long and silence
    # there is the defect this line exists to close, one layer up.
    norun=$(mktemp "${TMPDIR:-/tmp}/wt-cargo-norun.XXXXXX")
    set +e
    "${runner[@]}" "$@" --no-run 2>&1 | tee "$norun" >&2
    rc=${PIPESTATUS[0]}
    set -e
    if [ "$rc" -ne 0 ]; then
        rm -f "$norun"
        exit "$rc"
    fi
    binaries=$(grep -c '^ *Executable' "$norun" || true)
    rm -f "$norun"
    echo "wt-cargo: $binaries test binaries — cargo prints one Running line per binary and stops at the first that fails, so a run showing fewer, or no final test result line, did not finish and is not green" >&2
fi

exec "${runner[@]}" "$@"

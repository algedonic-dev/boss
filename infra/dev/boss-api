#!/usr/bin/env bash
# boss-api METHOD /api/path [body.json] — the door to the system of record.
#
# The curl wrapper every session, probe and builder uses to read and
# write the jobs API (CLAUDE.md §Doors): pinned base URL, the session's
# actor in X-Boss-User, the machine token when one is mounted, invoked
# BARE so it stays inside a permission allowlist. Body -> stdout, HTTP
# code -> stderr as one `HTTP:<code>` line, non-2xx exits 1 so drivers
# fail loudly (boss-driving-the-jobs-api item 1).
#
# Why it lives HERE and not only on the pod (backlog 0d8d7a90,
# 2026-09-14): until then it was pod-local text under /work/tools/bin
# that no gate read and no car shipped — a fresh pod, a second builder
# host, or a builder pod (design 90a14acc) would not have had it, and
# CLAUDE.md documented a door the tree could not reproduce. Same shape
# as wt-cargo (34b29b52, #364): the pod file was the spec, and the
# pod's /work/tools/bin/boss-api becomes a symlink to this file in the
# operator's checkout. Pinned by
# crates/core/boss-testing/tests/boss_api_sh.rs against a stub curl.
#
# Who a call signs as follows the boss CLI's rule
# (crates/orchestrators/boss-cli/src/identity.rs, backlog 5083d6f5):
# BOSS_ACTOR, else the actor file, else NOBODY — and nobody is loud. A
# WRITE with no actor is refused, naming both fixes; a READ, which
# attributes nothing, goes out marked operator:unidentified under the
# platform's own read role (audit-readonly — never the operator's
# platform-admin, backlog d843abf2) and says so once on stderr. Until
# 2026-09-14 (backlog 416d503c) the pod copy fell
# back to a fixed id instead, so a builder pod or a fresh session with
# no actor file wrote history as the operator's agent identity — two
# doors to one system of record with two provenance rules.
#
# The base URL, when BOSS_JOBS_URL does not name one, is the one line
# in `sor-url` beside this script — the ONE spelling of the
# system-of-record address in infra/dev (CLAUDE.md §9a). The boss shim
# (feat/the-boss-shim-lives-in-the-tree, parked as of 2026-09-14) is
# to read the same file when it lands; until then the pod's
# /work/tools/bin/boss still carries its own spelling.
#
# WHICH PORT — the path decides (backlog de0989d2, measured 2026-09-17
# 14:50Z). The system of record is several services on one LAN IP
# (design 28d2bed9, boss-jobs-internal.yaml), and this door sent every
# path to the jobs port — so `POST /api/people/accounts`, the account
# the first real sponsorship's reconcile step needs, which
# boss-accounts serves on 7550, could not be made through any door: the
# forge's reader is GET-only by design and this one could not route.
# Now the SERVICE comes from the ONE route table both doors source
# (../forge/probe-bin/sor-routes.sh, `sor_service_for_path`) and the
# PORT from a `name=port` table: BOSS_SOR_PORTS when set, else
# ../forge/sor-ports.env read as data from beside this file — the same
# file the forge's unattended prove door hands its reader, pinned to
# boss-ports by the_machine_door_carries_every_read_surface.rs. The host
# is kept; only the port moves. Absent both tables nothing is routed
# (the door as it was); a table that lacks the routed service is
# refused before curl, because a 404 from the wrong port is the defect
# this removes, not a fallback.
#
# WHEN NO PATH CAN ROUTE — `BOSS_SOR_SERVICE=<name>` (backlog bf1f5ad2,
# 2026-09-19). The gateway fronts every path there is, so no prefix
# routes to it; the machine door carries it as the one row a reader
# reaches BY NAME (the_machine_door_carries_every_read_surface.rs,
# NOT_PATH_ROUTED). The forge has such a reader — probe-bin/boss-gateway-read
# — and the pod had none, so a builder rehearsing a gateway probe set
# the host and the port table by hand and the door stopped being the
# door. Named, the name decides the service and the path decides
# nothing; unnamed, nothing changes. A name the table cannot place is
# refused before curl, with or without a table: the fall-through an
# unrouted path gets would send a gateway question to the jobs port,
# which answers. This door still SIGNS its calls, and a signed read is
# not a stranger's read — but the gateway strips every client
# `x-boss-*` header at its edge (role_headers.rs: identity comes from
# the session cookie, full stop), so what comes back is what a caller
# with no session gets. For a RECORDED probe, use the forge's reader:
# it sends nothing at all and prints the status alone.
#
# The pod-specific constants are env-overridable:
#   BOSS_JOBS_URL            the base URL; else the line in ./sor-url
#   BOSS_SOR_PORTS           `name=port …`; else ../forge/sor-ports.env
#   BOSS_SOR_READ_PORTS      the READ-ONLY rows, `name=port …`; else
#                              ./sor-read-ports.env (GET only, backlog 9a440539)
#   BOSS_SOR_READ_URL        the host those rows are read on; else the
#                              line in ./sor-read-url (boss-read-internal)
#   BOSS_SOR_SERVICE         the service to read, when no path routes to
#                              it (`gateway`); else the path decides
#   BOSS_ACTOR               who the call signs as — the id; else the one
#   BOSS_ACTOR_FILE            line in this file ($HOME/.config/boss/actor,
#                              as the boss CLI reads it)
#   BOSS_MACHINE_TOKEN_DIR   the machine token's mounted directory, whose
#                              `current` slot is sent; else the line in
#                              ./machine-token-dir, else /etc/boss/machine-token
#   BOSS_SOR_WAIT_SECONDS    how long a refused connect is waited out as
#                              a rollout (whole seconds; 0 = not at all);
#                              else 120
#
# A ROLLOUT IS WAITED OUT (backlog 034002b3, twice on 2026-09-23). The
# stack rolls with strategy Recreate, so every train that converges
# takes the jobs API dark for about a minute, and every write through
# this door in that minute exited 7 (`No route to host`) at once and
# had to be relaunched by hand. `curl_through_a_roll` re-sends ONLY a
# request that never left: curl exit 6 (could not resolve host) or 7
# (could not connect — refused, no route, network unreachable). Any
# other exit may be a request the server received — 28 is one code for
# a connect timeout AND a transfer that timed out after the body went,
# 52 and 56 are a reply lost after sending — so it is surfaced as
# before, and an HTTP status is an answer whatever it says. Each wait
# prints one line; past the window the door fails naming how long it
# waited, with curl's own exit code. The CLI's twin is
# `train::waiting_out_a_roll` (crates/orchestrators/boss-cli), the same
# rule and the same 120s over reqwest's own connect classification.
# The function itself lives in ../lib/curl-through-a-roll.sh since
# backlog 834ddb7c (2026-09-23): the pre-flight lints that read a
# registry needed the same wait, and a second copy is the defect
# (CLAUDE.md §9a). A copy of this script without that file refuses
# before curl, like one without its route table.
set -euo pipefail

METHOD=${1:-}; API_PATH=${2:-}; BODY=${3:-}
case "$METHOD" in
  GET|POST|PUT|PATCH|DELETE) ;;
  *) echo "usage: boss-api GET|POST|PUT|PATCH|DELETE /api/path [body.json]" >&2; exit 2 ;;
esac
[ -n "$API_PATH" ] || { echo "usage: boss-api GET|POST|PUT|PATCH|DELETE /api/path [body.json]" >&2; exit 2; }
# A PATH STARTS WITH `/`. curl is sent "$BASE$API_PATH", and the
# machine-token decision below reads the host of $BASE; a path like
# `@evil.invalid/x` would continue the authority and move the request,
# token and all, to another host (delta review of ddfa1032, B1). Every
# real path starts with a slash, so anything else is usage — refused
# here, before the token file is read and before curl.
case "$API_PATH" in
  /*) ;;
  *) echo "usage: boss-api GET|POST|PUT|PATCH|DELETE /api/path [body.json] — the path must start with '/', got '$API_PATH'" >&2; exit 2 ;;
esac
WAIT_WINDOW=${BOSS_SOR_WAIT_SECONDS:-120}
case "$WAIT_WINDOW" in
  ''|*[!0-9]*)
    echo "boss-api: BOSS_SOR_WAIT_SECONDS='$WAIT_WINDOW' is not a whole number of seconds — refusing rather than reading it as no wait or as forever" >&2
    exit 2
    ;;
esac

# readlink -f: the pod invokes this through a symlink, and sor-url sits
# beside the FILE, not the link.
HERE="$(dirname "$(readlink -f "$0")")"

# IS THIS DOOR THE TREE'S DOOR? (backlog 0b36dd65, 2026-09-19.) The pod
# reaches this file through a symlink into the operator's checkout, and
# nothing keeps that checkout on origin/main — it was two commits behind
# for most of one working day while every door ran from it, and the
# routing block below was among what was missing, so a builder's read
# came back HTTP:404 from the jobs port. A stale copy ANSWERS; it does
# not error. So a READ says so beside its answer, where the reader can
# judge it, and a WRITE is refused: what a write lands in the audit log
# is immutable, and there is no reading that back under a warning. The
# judgement is local and never fetches (door-freshness.sh says why).
FRESHNESS_FILE="$HERE/door-freshness.sh"
if [ -r "$FRESHNESS_FILE" ]; then
  # shellcheck source=door-freshness.sh
  . "$FRESHNESS_FILE"
  if STALE=$(door_is_stale "$0"); then
    case "$METHOD" in
      GET)
        echo "boss-api: WARNING — $STALE" >&2
        ;;
      *)
        echo "boss-api: REFUSED $METHOD $API_PATH: a write is not signed from a door that is not the tree's, and a read still runs under a warning (BOSS_DOOR_FRESHNESS=off runs this one anyway, if you mean it). $STALE" >&2
        exit 78
        ;;
    esac
  fi
fi

SOR_URL_FILE="$HERE/sor-url"
BASE=${BOSS_JOBS_URL:-$(head -n1 "$SOR_URL_FILE" 2>/dev/null || true)}
[ -n "$BASE" ] || {
  echo "boss-api: BOSS_JOBS_URL is unset and $SOR_URL_FILE names no system of record — a copy of this script without its sor-url has no default" >&2
  exit 2
}

# The port table: BOSS_SOR_PORTS, else the forge's env file read as
# data (`#` and blank lines dropped, one space-separated line) the way
# boss prove --unattended reads it. Absent both, nothing below routes.
SOR_PORTS_FILE="$HERE/../forge/sor-ports.env"
SOR_PORTS=${BOSS_SOR_PORTS:-}; SOR_PORTS_FROM=BOSS_SOR_PORTS
if [ -z "$SOR_PORTS" ] && [ -r "$SOR_PORTS_FILE" ]; then
  SOR_PORTS=$(grep -Ev '^[[:space:]]*(#|$)' "$SOR_PORTS_FILE" | tr -s '[:space:]' ' ' | sed 's/^ //; s/ $//' || true)
  SOR_PORTS_FROM=$SOR_PORTS_FILE
fi
# A NAME, when no path can route (backlog bf1f5ad2). Blank is not a
# name, as everywhere else here. Absent a table there is nothing to
# place it against, and leaving on the base would send a gateway
# question to the jobs port — refuse instead.
NAMED_SERVICE=$(printf '%s' "${BOSS_SOR_SERVICE:-}" | tr -d '[:space:]')
if [ -n "$NAMED_SERVICE" ] && [ -z "$SOR_PORTS" ]; then
  echo "boss-api: refusing $METHOD $API_PATH: BOSS_SOR_SERVICE names \`$NAMED_SERVICE\`, and no port table was found (BOSS_SOR_PORTS is unset and $SOR_PORTS_FILE is not readable) — so there is nothing to place that name against. Sending it to the base would ask $NAMED_SERVICE's question of the jobs port, which answers instead of erroring." >&2
  exit 2
fi
# THE READ-ONLY ROWS (backlog 9a440539, 2026-10-01). The LAN table above
# carries the services a machine on the LAN may reach, writes included;
# it never carried assets, customers or the other module services, so a
# read of live data before a migration could not be made through any
# door. These rows are the rest of boss-ports that the boss pod serves
# off loopback, on the in-cluster boss-read-internal Service (./sor-read-url)
# — and only a GET goes there. Same overrides as the LAN table:
# BOSS_SOR_READ_PORTS / BOSS_SOR_READ_URL, else the files beside this
# script. Pinned by every_boss_ports_service_has_a_door.rs.
SOR_READ_PORTS_FILE="$HERE/sor-read-ports.env"
SOR_READ_PORTS=${BOSS_SOR_READ_PORTS:-}; SOR_READ_PORTS_FROM=BOSS_SOR_READ_PORTS
if [ -z "$SOR_READ_PORTS" ] && [ -r "$SOR_READ_PORTS_FILE" ]; then
  SOR_READ_PORTS=$(grep -Ev '^[[:space:]]*(#|$)' "$SOR_READ_PORTS_FILE" | tr -s '[:space:]' ' ' | sed 's/^ //; s/ $//' || true)
  SOR_READ_PORTS_FROM=$SOR_READ_PORTS_FILE
fi
if [ -n "$SOR_PORTS" ]; then
  SOR_ROUTES="$HERE/../forge/probe-bin/sor-routes.sh"
  [ -r "$SOR_ROUTES" ] || {
    echo "boss-api: a port table is set ($SOR_PORTS_FROM) but $SOR_ROUTES is missing — a copy of this script without the route table cannot say which port $API_PATH belongs to" >&2
    exit 2
  }
  # shellcheck source=../forge/probe-bin/sor-routes.sh
  . "$SOR_ROUTES"
  if [ -n "$NAMED_SERVICE" ]; then
    SERVICE=$NAMED_SERVICE; SERVICE_FROM="BOSS_SOR_SERVICE names it"
  else
    SERVICE=$(sor_service_for_path "$API_PATH"); SERVICE_FROM="the path is served by $SERVICE"
  fi
  if [ "$SERVICE" != jobs ]; then
    if PORT=$(sor_port_for_service "$SERVICE" "$SOR_PORTS"); then
      BASE=$(sor_base_on_port "$BASE" "$PORT")
    elif PORT=$(sor_port_for_service "$SERVICE" "$SOR_READ_PORTS"); then
      # A read-only row: GET only, refused before the URL file is even
      # read for anything else — the door does not widen what a write
      # may reach (backlog 9a440539).
      [ "$METHOD" = GET ] || {
        echo "boss-api: refusing $METHOD $API_PATH: $SERVICE_FROM, which this door carries for READS only (row from $SOR_READ_PORTS_FROM, on the in-cluster read Service). The LAN machine door does not carry $SERVICE, and widening what a write may reach is its own decision, made on a row of infra/forge/sor-ports.env with its reason — not here." >&2
        exit 2
      }
      READ_BASE=${BOSS_SOR_READ_URL:-$(head -n1 "$HERE/sor-read-url" 2>/dev/null || true)}
      READ_BASE=$(printf '%s' "$READ_BASE" | tr -d '[:space:]')
      [ -n "$READ_BASE" ] || {
        echo "boss-api: refusing $METHOD $API_PATH: $SERVICE_FROM, a read-only row, and BOSS_SOR_READ_URL is unset and $HERE/sor-read-url names no host — sending it to the jobs port would answer 404 about a surface that exists." >&2
        exit 2
      }
      BASE=$(sor_base_on_port "$READ_BASE" "$PORT")
    else
      echo "boss-api: refusing $METHOD $API_PATH: $SERVICE_FROM, and the port table names no port for $SERVICE (table: '$SOR_PORTS', from $SOR_PORTS_FROM; read-only rows: '$SOR_READ_PORTS', from $SOR_READ_PORTS_FROM). Sending it to the jobs port would answer 404 about a surface that exists — refusing rather than guessing." >&2
      exit 2
    fi
  fi
fi

# Blank and whitespace-only values are NOT answers (identity.rs): an
# `export BOSS_ACTOR=` or an empty file falls through, never signs as "".
ACTOR_FILE=${BOSS_ACTOR_FILE:-$HOME/.config/boss/actor}
ACTOR_ID=$(printf '%s' "${BOSS_ACTOR:-}" | tr -d '[:space:]')
[ -n "$ACTOR_ID" ] || ACTOR_ID=$(head -n1 "$ACTOR_FILE" 2>/dev/null | tr -d '[:space:]' || true)
# A NAMED caller gets the operator's role. Nobody-in-particular does NOT
# (backlog d843abf2, measured 2026-09-18: an unnamed read rode the same
# platform-admin header and saw the whole world): it reads under the
# platform's own read role, audit-readonly at the auditor tier — the
# one a recorded probe's reader carries — full-width on every list and
# 403 on every write. The role's one home is boss_core::roles
# (identity.rs reads it from there); this copy is pinned equal by
# crates/core/boss-testing/tests/boss_api_sh.rs.
ROLE=platform-admin; TIER=operator
if [ -z "$ACTOR_ID" ]; then
  case "$METHOD" in
    GET)
      ACTOR_ID=operator:unidentified; ROLE=audit-readonly; TIER=auditor
      echo "boss-api: nothing names the actor running this command — reading as \`$ACTOR_ID\` under the $ROLE role. Writes will be refused until \`BOSS_ACTOR\` (or the actor file) names you." >&2
      ;;
    *)
      # The CLI's refusal, with the identity THIS door used to fall back
      # to in place of the conductor, so a reader tells it apart from a
      # policy denial.
      echo "boss-api: refusing to sign $METHOD $API_PATH: nothing names the actor running this command, and signing it as \`claude@algedonic.dev\` would credit the operator's agent identity with your act (backlog 416d503c). Name yourself with \`export BOSS_ACTOR=<your id>\` or by writing that id into $ACTOR_FILE." >&2
      exit 2
      ;;
  esac
fi
ACTOR='{"id":"'"$ACTOR_ID"'","role":"'"$ROLE"'","access_tier":"'"$TIER"'","territory_account_ids":[],"direct_report_ids":[],"department":null}'

args=( -sS -X "$METHOD" -H 'Content-Type: application/json' -H "X-Boss-User: $ACTOR" -w '\n%{http_code}' )
# THE MACHINE TOKEN — read, host-checked and handed to curl by the ONE
# shell reader, infra/lib/secret-header.sh's machine_token_header, which
# every shell sender of the token takes (design 6805c764 car 4).
#
# A DIRECTORY, NOT A FILE (backlog 1876bbdb, INFO-6). The token is the
# `current` slot of the mounted `boss-machine-token` Secret, the one
# layout boss-core's clients and every service's gate read. This door
# read a token FILE, by default /etc/boss/machine-token itself; the day
# car 4 mounted the directory there, every write through
# the door would have gone out unstamped, in silence.
#
# THE DOORS' OWN COPY (INFO-5). On the dev pod the Secret is mounted at
# the directory ./machine-token-dir names, NOT at boss-core's default:
# builders run handler tests there, and every stamping client a test
# builds reads the default. So only the doors — this one and the boss
# shim — read machine-token-dir, and only when BOSS_MACHINE_TOKEN_DIR
# names nothing; a copy of the door without that file takes the
# default, as boss-core does.
#
# IN A FILE, NEVER IN curl's ARGV (backlog 5f3ad356): a command line is
# world-readable in ps while curl runs. The lib writes it 0600 and hands
# curl `-H @file`; infra/lint/a-secret-header-rides-in-a-file.sh keeps it
# out of argv. A copy of the door without the lib still runs where there
# is no token, and refuses where there is one.
#
# ONLY TO AN ESTATE HOST (backlog 2ee29275, F1). The base is whatever
# BOSS_JOBS_URL says, and an operator can point it anywhere — the public
# edge (which answers with a 302 to Cloudflare Access), another instance.
# The lib stamps loopback and the hosts BOSS_MACHINE_TOKEN_HOSTS lists
# (an entry with a leading dot is a suffix) — boss-core's
# machine_token::Hosts, held equal to it on the rows of the tables in
# boss_api_sh.rs and secret_header_sh.rs (off them, the named and
# measured differences in the lib's header). UNSET, the list is the host of this door's
# own sor-url (the pod's record); set, even empty, it wins. Anywhere else
# the call goes out without the token and says so once, naming the
# scheme and host and never the path, query or userinfo.
#
# THE READ DOOR'S HOST IS ON THE LIST TOO (backlog 9a440539, review
# 1d893c98 B1). boss-read-internal is a second ClusterIP in front of the
# SAME pod, and every service behind it mounts the machine gate; in
# report mode an unstamped read is tallied as a MISS, which restarts the
# clean window enforcement has to earn, and under enforce it is a 401.
# So the unset list is BOTH files' hosts — ./sor-url's and
# ./sor-read-url's, read from the files and never from an override: a
# BOSS_SOR_READ_URL aimed elsewhere goes out unstamped, exactly as a
# BOSS_JOBS_URL aimed elsewhere does.
if [ -z "${BOSS_MACHINE_TOKEN_DIR:-}" ] && [ -s "$HERE/machine-token-dir" ]; then
  BOSS_MACHINE_TOKEN_DIR=$(tr -d '[:space:]' < "$HERE/machine-token-dir")
fi
SECRET_LIB="$HERE/../lib/secret-header.sh"
if [ -r "$SECRET_LIB" ]; then
  # shellcheck source=../lib/secret-header.sh
  . "$SECRET_LIB"
  TOKEN_HOSTS=$(machine_token_host "$(head -n1 "$SOR_URL_FILE" 2>/dev/null || true)")
  READ_TOKEN_HOST=$(machine_token_host "$(head -n1 "$HERE/sor-read-url" 2>/dev/null || true)")
  [ -z "$READ_TOKEN_HOST" ] || TOKEN_HOSTS="$TOKEN_HOSTS,$READ_TOKEN_HOST"
  machine_token_header TOKEN_HDR "$BASE" "$TOKEN_HOSTS"
  [ -z "$TOKEN_HDR" ] || args+=( -H "$TOKEN_HDR" )
elif [ -e "${BOSS_MACHINE_TOKEN_DIR:-/etc/boss/machine-token}/current" ]; then
  echo "boss-api: refusing $METHOD $API_PATH: $SECRET_LIB is missing — without it the machine token would ride in curl's command line, readable in ps by every local user (backlog 5f3ad356)" >&2
  exit 2
fi
[ -n "$BODY" ] && args+=( --data-binary "@$BODY" )

# curl, re-sent only while the request never left (the header above
# says which exits those are and why). Prints the answer; returns
# curl's own code, so a caller sees exactly what it saw before. The
# ONE definition is in infra/lib, found from this file's real location
# ($HERE is readlink -f'd above: the pod reaches this through a
# symlink). Sourced here, after every refusal above, so each of those
# still refuses in its own words whether or not the file is present.
ROLL_LIB="$HERE/../lib/curl-through-a-roll.sh"
[ -r "$ROLL_LIB" ] || {
  echo "boss-api: refusing $METHOD $API_PATH: $ROLL_LIB is missing — a copy of this script without the tree's infra/lib cannot wait out a rollout, and sending without that wait would make a rollout minute a failed write again (backlog 034002b3)" >&2
  exit 2
}
# shellcheck source=../lib/curl-through-a-roll.sh
. "$ROLL_LIB"

out=$(curl_through_a_roll "$WAIT_WINDOW" boss-api 'the jobs API' "$METHOD $API_PATH" "${args[@]}" "$BASE$API_PATH")
code=${out##*$'\n'}
body=${out%"$code"}
printf '%s' "$body"
printf 'HTTP:%s\n' "$code" >&2
case "$code" in 2*) exit 0 ;; *) exit 1 ;; esac

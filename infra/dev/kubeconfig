# The ONE kubeconfig the trusted dev doors hand kubectl (backlog
# 62895f2d). control-tools.py sets KUBECONFIG to this file inside the
# published generation, where it is owned, packed and hash-checked with
# the two binaries; it refuses a copy its uid does not own or that group
# or world can write. It used to be /work/home/.kube/config, found by
# HOME and measured -rw-rw-r-- root:1500: anyone in that group could
# repoint the pinned kubectl at another server and be handed the token.
#
# It holds no credential. It names this pod's own ServiceAccount, read
# from the kubelet's projected mount, in the namespace the dev session
# drives — the same cluster, user and namespace the old file named.
apiVersion: v1
kind: Config
clusters:
- name: in-cluster
  cluster:
    server: https://kubernetes.default.svc
    certificate-authority: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
users:
- name: dev-session
  user:
    tokenFile: /var/run/secrets/kubernetes.io/serviceaccount/token
contexts:
- name: in-cluster
  context:
    cluster: in-cluster
    user: dev-session
    namespace: boss-dev
current-context: in-cluster

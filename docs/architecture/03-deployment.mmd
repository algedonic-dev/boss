%%{init: {'theme':'base', 'themeVariables': { 'primaryColor':'#fafaf9', 'primaryBorderColor':'#57534e', 'primaryTextColor':'#1c1917', 'lineColor':'#78716c', 'fontFamily':'ui-sans-serif, system-ui, sans-serif', 'fontSize':'17px'}}}%%
flowchart TB
    %% What a deployer runs: infra/oss-quickstart (backlog 34717528,
    %% decided 2026-09-25). The KB ships with every instance of the
    %% open-source release, so this is the release's topology, not ours.
    %% Where a given instance runs is its estate registry, rendered live
    %% at /it/estate; drawing that here would be a second copy. Per-service
    %% ports are not repeated here either: 02-service-map.mmd carries them,
    %% pinned to boss-ports.

    subgraph Clients ["Clients"]
        direction LR
        WEB["Web browser<br/><small>the apps/web SPA,<br/>served by the gateway</small>"]
        CLI["<code>boss</code> CLI + agents<br/><small>the same HTTP API<br/>the SPA calls</small>"]
    end

    PROXY["Your TLS reverse proxy<br/><small>Caddy (infra/caddy/Caddyfile), nginx,<br/>a load balancer or a tunnel &mdash;<br/>not part of the compose file</small>"]

    subgraph Compose ["Docker compose &mdash; infra/oss-quickstart/docker-compose.yml"]
        direction TB

        INIT["<b>boss-init</b> &mdash; one-shot, on every start<br/><small>converges the schema &middot; seeds the platform Workflow bundle<br/>first start only: bootstrap-admin credential, sim clock</small>"]

        subgraph Services ["boss-services &mdash; one container, image boss:latest, run by services-launcher.sh"]
            direction TB
            GATEWAY["<b>boss-gateway</b> &mdash; host port 4443, plain HTTP<br/><small>serves the SPA &middot; local-auth sessions &middot; reverse proxy for /api/*</small>"]
            APIS["API services<br/><small>every row of the port registry (boss-ports)<br/>that the tenant manifest's [modules] asks for;<br/>platform services always start</small>"]
            DAEMONS["Runtime daemons<br/><small>boss-dispatcher &mdash; step.done rules<br/>boss-event-relay &mdash; outbox &rarr; audit_log + NATS</small>"]
            SIM["boss-brewery-sim<br/><small>the demo tenant's sim &mdash;<br/>only where the tenant declares one</small>"]
        end

        subgraph Data ["State"]
            direction LR
            PG[("postgres:16<br/><small>volume postgres-data<br/>audit_log hash-chained</small>")]
            NATS_N[("nats:2.10<br/><small>JetStream</small>")]
            VOL[("volumes<br/><small>boss-auth: credentials<br/>boss-files: attachment bytes</small>")]
        end
    end

    %% Client traffic
    WEB ==>|"HTTPS"| PROXY
    CLI -.->|"HTTPS"| PROXY
    PROXY ==>|"HTTP"| GATEWAY

    %% Inside the container
    GATEWAY ==>|"/api/*"| APIS
    SIM -.->|"the public API"| GATEWAY

    %% Start order and state
    INIT -.->|"exits, then"| Services
    INIT ==> PG
    INIT -.-> VOL
    APIS ==> PG
    APIS ==> NATS_N
    DAEMONS ==> NATS_N
    DAEMONS ==> PG
    Services -.-> VOL

    classDef client fill:#e0e7ff,stroke:#312e81,stroke-width:2px
    classDef edge fill:#ffedd5,stroke:#c2410c,stroke-width:2px,stroke-dasharray:4 3
    classDef gw fill:#fef3c7,stroke:#a16207,stroke-width:2px
    classDef svc fill:#dbeafe,stroke:#1d4ed8,stroke-width:1.5px
    classDef init fill:#d1fae5,stroke:#047857,stroke-width:1.5px
    classDef tenant fill:#fce7f3,stroke:#be185d,stroke-width:1.5px
    classDef daemon fill:#ede9fe,stroke:#6d28d9,stroke-width:1.5px
    classDef store fill:#f3f4f6,stroke:#1f2937,stroke-width:2px
    class WEB,CLI client
    class PROXY edge
    class GATEWAY gw
    class APIS svc
    class INIT init
    class SIM tenant
    class DAEMONS daemon
    class PG,NATS_N,VOL store

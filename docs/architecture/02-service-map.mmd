%%{init: {'theme':'base', 'themeVariables': { 'primaryColor':'#fafaf9', 'primaryBorderColor':'#57534e', 'primaryTextColor':'#1c1917', 'lineColor':'#a8a29e', 'fontFamily':'ui-sans-serif, system-ui, sans-serif', 'fontSize':'17px'}}}%%
flowchart TB
    %% Every service node names its port-registry row as `<name> :<prod port>`.
    %% crates/core/boss-ports holds this file equal to its table
    %% (service_map_agreement): a row not drawn, or a node with no row,
    %% fails that crate's tests by name (backlog f1d84e3f, 2026-09-27).

    BROWSER["Browser / CLI / agents<br/><small>apps/web SPA &middot; boss CLI &middot; any HTTP client</small>"]

    GW["<b>boss-gateway</b><br/><small>gateway :4443<br/>serves the SPA &middot; session auth &middot; reverse proxy for /api/* &middot; perf histograms</small>"]

    BROWSER ==> GW

    subgraph Core ["Tier 1 &mdash; core state-machine OS (crates/core)"]
        direction LR
        JOBS_S["<b>boss-jobs-api</b><br/><small>jobs :7900<br/>Jobs + Steps<br/>Workflow, StepType + StepPlugin registries</small>"]
        POL_S["<b>boss-policy-api</b><br/><small>policy :7250<br/>row-level auth<br/>every write gated</small>"]
        EVT_S["<b>boss-events-api</b><br/><small>events :7150<br/>audit_log tail, stream + export</small>"]
        CLS_S["<b>boss-classes-api</b><br/><small>classes :7800<br/>Class registry<br/>(roles, departments, categories)</small>"]
        SK_S["<b>boss-subject-kinds-api</b><br/><small>subject-kinds :7830<br/>SubjectKind registry</small>"]
        LOC_S["<b>boss-locations-api</b><br/><small>locations :7820<br/>hierarchy + timezone + geo</small>"]
        CAL_S["<b>boss-calendar-api</b><br/><small>calendar :7860<br/>Reservations<br/>strength rules + conflicts</small>"]
        CLK_S["<b>boss-clock-api</b><br/><small>clock :7060<br/>the one authority for now<br/>(wall or sim)</small>"]
        CONT_S["<b>boss-content-api</b><br/><small>content :7090<br/>documents + bulletins</small>"]
        SRCH_S["<b>boss-search-api</b><br/><small>search :7960<br/>global search</small>"]
        VIEW_S["<b>boss-views-api</b><br/><small>views :7961<br/>View registry + runner</small>"]
    end

    subgraph CoreDaemons ["Tier 1 &mdash; runtime daemons"]
        direction LR
        DISP["<b>boss-dispatcher</b><br/><small>dispatcher :7950<br/>step.done.&lt;kind&gt; &rarr;<br/>data-driven rule registry</small>"]
        RELAY["<b>boss-event-relay</b><br/><small>event_outbox &rarr;<br/>audit_log + NATS</small>"]
    end

    subgraph Modules ["Tier 2 &mdash; company-modeling modules (crates/modules)"]
        direction LR
        PPL_S["boss-people-api<br/><small>people :7500<br/>employees, org chart</small>"]
        ACC_S["boss-accounts-api<br/><small>accounts :7550<br/>accounts, notes, support cases</small>"]
        CUST_S["boss-customers-api<br/><small>customers :7855</small>"]
        CAMP_S["boss-campaigns-api<br/><small>campaigns :7845</small>"]
        COMM_S["boss-commerce-api<br/><small>commerce :7400<br/>opportunities, invoices</small>"]
        PROD_S["boss-products-api<br/><small>products :7840<br/>finished-product catalog</small>"]
        INV_S["boss-inventory-api<br/><small>inventory :7300<br/>stock, POs, vendors</small>"]
        SHIP_S["boss-shipping-api<br/><small>shipping :7100<br/>shipments + scans</small>"]
        KB_S["boss-catalog-api<br/><small>catalog :7750<br/>equipment models + parts</small>"]
        ASSETS_S["boss-assets-api<br/><small>assets :7600<br/>per-unit equipment</small>"]
        MSG_S["boss-messages-api<br/><small>messages :7200<br/>unified inbox</small>"]
        LDG_S["boss-ledger-api<br/><small>ledger :7080<br/>financial_facts &rarr; GL</small>"]
    end

    subgraph Orchestrators ["Cross-tier orchestrators (crates/orchestrators)"]
        direction LR
        ML_S["boss-ml-api<br/><small>ml :7070<br/>models + predictions</small>"]
        SIMUI["boss-simulator<br/><small>simulator :7010<br/>the /simulator UX</small>"]
    end

    subgraph Tenant ["Tier 3 &mdash; the example tenant (crates/tenants)"]
        direction LR
        BREW["boss-brewery-sim<br/><small>sim-control :7011<br/>Algedonic Ales sim daemon;<br/>its control port is localhost-only</small>"]
    end

    subgraph Clients ["Cross-service client crates &mdash; the narrow HTTP contract"]
        direction LR
        C_NOTE["<small>Each service calls other services only through typed client traits:<br/><code>boss-policy-client</code> &middot; <code>boss-classes-client</code> &middot; <code>boss-subject-kinds-client</code> &middot; <code>boss-locations-client</code><br/><code>boss-calendar-client</code> &middot; <code>boss-clock-client</code> &middot; <code>boss-people-client</code> &middot; <code>boss-assets-client</code><br/><code>boss-catalog-client</code> &middot; <code>boss-inventory-client</code> &middot; <code>boss-shipping-client</code><br/><br/>In tests, these are swapped for in-memory fakes &mdash; no cross-service HTTP required.</small>"]
    end

    subgraph Infra ["Shared infrastructure"]
        direction LR
        PG[("Postgres<br/><small>audit_log (hash-chained)</small>")]
        NATS[("NATS<br/><small>event bus</small>")]
    end

    %% Gateway fans out to HTTP services
    GW ==> Core
    GW ==> Modules
    GW ==> Orchestrators

    %% Policy gate (the core services call it too; an edge from the Core
    %% subgraph to a node inside it tangles the layout, so the policy
    %% node says it instead)
    Modules -. "every write" .-> POL_S

    %% The tenant drives the public API; the simulator UX talks to its daemon
    BREW -. "public API" .-> GW
    SIMUI -. "control + telemetry" .-> BREW

    %% Shared infra
    Core ==> Infra
    CoreDaemons ==> Infra
    Modules ==> Infra
    Orchestrators ==> Infra

    classDef edge fill:#fef3c7,stroke:#a16207,stroke-width:2px
    classDef core fill:#fef3c7,stroke:#a16207,stroke-width:2px
    classDef module fill:#dbeafe,stroke:#1d4ed8,stroke-width:1.5px
    classDef orchestrator fill:#fef9c3,stroke:#a16207,stroke-width:1.5px
    classDef tenant fill:#fce7f3,stroke:#be185d,stroke-width:1.5px
    classDef agent fill:#ede9fe,stroke:#6d28d9,stroke-width:1.5px
    classDef infra fill:#f3f4f6,stroke:#1f2937,stroke-width:2px
    classDef user fill:#e0e7ff,stroke:#312e81,stroke-width:2px
    classDef client fill:#fff,stroke:#374151,stroke-width:1.5px

    class BROWSER user
    class GW edge
    class JOBS_S,POL_S,EVT_S,CLS_S,SK_S,LOC_S,CAL_S,CLK_S,CONT_S,SRCH_S,VIEW_S core
    class DISP,RELAY agent
    class PPL_S,ACC_S,CUST_S,CAMP_S,COMM_S,PROD_S,INV_S,SHIP_S,KB_S,ASSETS_S,MSG_S,LDG_S module
    class ML_S,SIMUI orchestrator
    class BREW tenant
    class PG,NATS infra
    class C_NOTE client

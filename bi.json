{"kind":"backlog-item","version":1,"status":"active","label":"Backlog item","description":"One piece of engineering backlog, modelled as work rather than a line in a markdown file. The Subject is the area it touches, so \"what is outstanding against the ledger\" answers from Subject history. Triage requires the evidence behind the routing decision, because the failure mode of a backlog is not neglect but confident wrong answers read off its own text — an internal claim about the codebase decays every time the codebase moves. `stale` exists for the items that die without anyone doing them, and `verify` for the ones whose claim needs re-measuring before anyone acts.","category":"platform","subject_kinds":["custom"],"steps":[{"title":"filed","kind":"trigger","ready_when":"true","title_template":"Filed to the backlog","sign_offs_required":[],"fields":[],"authority_role":null,"metadata_defaults":{"trigger_kind":"operator","trigger_name":"item-enters-the-backlog"}},{"title":"triage","kind":"task","ready_when":"steps.filed.done","title_template":"Measure the claim, choose a route","sign_offs_required":[],"fields":[{"name":"disposition","field_type":"verify|design|build|duplicate|stale|decline","required":true},{"name":"evidence","field_type":"string","required":true}],"authority_role":"platform-admin","metadata_defaults":null},{"title":"measure","kind":"task","ready_when":"steps.triage.done AND steps.triage.metadata.disposition = \"verify\"","title_template":"Re-measure the claim","sign_offs_required":[],"fields":[],"authority_role":"platform-admin","metadata_defaults":null},{"title":"design-review","kind":"task","ready_when":"steps.triage.done AND steps.triage.metadata.disposition = \"design\"","title_template":"Decide the design","sign_offs_required":[],"fields":[],"authority_role":"platform-admin","metadata_defaults":null},{"title":"build","kind":"task","ready_when":"steps.triage.done AND steps.triage.metadata.disposition = \"build\"","title_template":"Build the change","sign_offs_required":[],"fields":[],"authority_role":"platform-admin","metadata_defaults":null},{"title":"duplicate","kind":"outcome","ready_when":"steps.triage.done AND steps.triage.metadata.disposition = \"duplicate\"","terminal":{"outcome":"duplicate"},"title_template":"Closed as a duplicate","sign_offs_required":[],"fields":[],"authority_role":null,"metadata_defaults":{"outcome_kind":"withdrawn"}},{"title":"stale","kind":"outcome","ready_when":"steps.triage.done AND steps.triage.metadata.disposition = \"stale\"","terminal":{"outcome":"stale"},"title_template":"Closed — the claim no longer holds","sign_offs_required":[],"fields":[],"authority_role":null,"metadata_defaults":{"outcome_kind":"withdrawn"}},{"title":"declined","kind":"outcome","ready_when":"steps.triage.done AND steps.triage.metadata.disposition = \"decline\"","terminal":{"outcome":"declined"},"title_template":"Closed without action","sign_offs_required":[],"fields":[],"authority_role":null,"metadata_defaults":{"outcome_kind":"aborted"}},{"title":"closed","kind":"outcome","ready_when":"steps.measure.done OR steps.design-review.done OR steps.build.done","terminal":{"outcome":"completed"},"title_template":"Backlog item closed","sign_offs_required":[],"fields":[],"authority_role":null,"metadata_defaults":{"outcome_kind":"completed"}}],"metadata_schema":{},"entitlements":{},"metadata":{"owner_role":"platform-admin"},"owning_team":"platform","authoring_job_id":null,"created_at":"2026-08-07T21:23:49.988811Z"}
